<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwiftX.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SwiftX.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="SwiftX app">

    <!-- The SwiftX app window. Built on windows-app-mx's LogiApp (branch logiApp/dotnet): its
         MainPage supplies the Home header (greeting + right-aligned round toolbar buttons) and its
         SettingsPage supplies the Settings screen wholesale (270px sidebar, two-line editorial
         title, 44px rows with a 4px accent indicator, 48,28,64,48 content padding, 780 cap).
         See docs/full-app-mockups-logi-base.md for the mockups this is built to and
         docs/swiftx-app-shell-plan.md for the screen-by-screen plan.

         Logi navigates a Frame between MainPage / ActionRingPage / SettingsPage. Here the four
         screens are siblings in one Grid whose Visibility is switched (ShowScreen) — the same
         idiom Logi's own ActionRingPage uses to swap its Layout view for its Explore AI view
         inside a single Grid, and the one that lets every screen keep the live state this window
         already holds (the orbit preview's slot geometry and drag state chief among it) instead of
         rebuilding it on every navigation.

         WinUI Window has no Resources; shared styles live on the root Grid. -->
    <Grid x:Name="Root" Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.Resources>
            <!-- Logi's card: SettingsCardBackgroundBrush over SettingsCardBorderBrush at 1px and
                 CornerRadius 8, carried here as the Shell* tokens (Themes/Colors.xaml). Padding is
                 SwiftX's own 16,14 rather than Logi's 24 — these cards hold a control on the right
                 (a toggle, a slider, a pair of buttons), not Logi's flat label-and-paragraph. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ShellCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ShellCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <!-- ThemeResource inside a Style resolves against the element the style lands on,
                 so Light never paints Dark secondary text into a white card. -->
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SettingsSecondaryTextBrush}" />
            </Style>
            <Style x:Key="SecondaryCaption" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SettingsSecondaryTextBrush}" />
            </Style>

            <!-- ==================== Logi's type ramp ====================
                 Measured off LogiApp/SettingsPage.xaml — see docs/settings-screen-logi-alignment-plan.md
                 §A.3, which tabulates the whole ramp. Two letter-spacing values only: 100 for nav
                 labels, 80 for calls to action, both all-caps. -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsHeaderBrush}" />
                <Setter Property="Margin" Value="0,0,0,28" />
            </Style>
            <!-- A screen's own title, above its content rather than in a rail: Logi's
                 ActionRingPage header (20 Bold) rather than SettingsPage's 22. -->
            <Style x:Key="ScreenTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsHeaderBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsTitleBrush}" />
            </Style>
            <Style x:Key="PrivacyHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsAccentBrush}" />
            </Style>
            <Style x:Key="SettingBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsSecondaryTextBrush}" />
            </Style>

            <!-- The Orbit sidebar's own three steps, measured off docs/images/17-app-ring.svg:
                 an all-caps eyebrow naming what the panel currently is, a 15px Bold heading per
                 section, and an 11.5px caption under it. A step up from SettingTitle/SettingBody
                 above because these sit flush on the sidebar's own ground rather than inside a
                 card, so the heading is carrying the separation that a card's edge would. -->
            <Style x:Key="SidebarEyebrow" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="160" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsMutedBrush}" />
            </Style>
            <Style x:Key="SidebarHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsHeaderBrush}" />
            </Style>
            <Style x:Key="SidebarCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsMutedBrush}" />
            </Style>
            <!-- The two-line 30px editorial title Logi puts in its Settings sidebar, in the
                 Segoe UI / Cambria / Georgia stack it names. -->
            <Style x:Key="EditorialTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI, Cambria, Georgia" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="LineHeight" Value="34" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsHeaderBrush}" />
            </Style>

            <!-- Settings call-to-action: small, semibold, all-caps accent text with no button
                 chrome. Sets no Foreground of its own on purpose — HyperlinkButton's template
                 drives its colour from the four HyperlinkButtonForeground* keys in every visual
                 state, so a Foreground setter here would be honoured at rest and thrown away the
                 moment the pointer touched it. CharacterSpacing 80 is Logi's CTA value. -->
            <Style x:Key="AccentLink" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>

            <!-- Logi's round 36x36 chrome button: the theme toggle and gear on the header, and the
                 back arrow on every sub-screen. Transparent at rest so only the glyph reads; the
                 framework's own pointer-over fill still supplies the hover affordance. -->
            <Style x:Key="ChromeIconButton" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- One row of Logi's Settings rail. The 4px indicator and the label colour are the
                 only two things that change with selection — never a background fill. -->
            <Style x:Key="RailButton" TargetType="Button">
                <Setter Property="Height" Value="44" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style x:Key="RailLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- The Home tiles' drop shadow, explicitly asked for. WinUI has no CSS box-shadow;
                 ThemeShadow on a Translation-lifted element is the framework's own answer and,
                 unlike a Composition DropShadow, it re-renders itself for the theme.
                 One shadow shared by the casters rather than one each: ThemeShadow is designed
                 to be shared, and outside a popup it only draws onto elements in its Receivers
                 collection — which is a collection this window has to populate in code (see the
                 Loaded handler), so there is exactly one of them to populate. -->
            <ThemeShadow x:Key="BoxShadow" />

            <!-- Hairline between Home header actions: Elements | theme | Settings. -->
            <Style x:Key="HeaderToolbarDivider" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource ShellDividerBrush}" />
            </Style>

            <!-- The footer strip at the bottom of a Home nav box — Logi's own "ADD" bar. -->
            <Style x:Key="BoxOpenLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsAccentBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0 is the shared Controls.AppTitleBar (the same one the tool windows use), built in
             code-behind because its constructor takes glyph/title and XAML object elements need a
             parameterless constructor. -->

        <Grid Grid.Row="1">

            <!-- ==================================================================
                 HOME — brand wordmark + right-aligned toolbar, then the Orbit
                 mark and the Tools nav box.
                 ================================================================== -->
            <Grid x:Name="HomeScreen">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="40,20,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- "SwiftX" with the app mark standing in for the X. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="Swift"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI, Cambria, Georgia, 'Times New Roman'"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{ThemeResource SettingsHeaderBrush}" />
                        <ContentControl x:Name="HomeBrandMark" Width="30" Height="30"
                                        VerticalAlignment="Center" Margin="2,2,0,0"
                                        IsTabStop="False" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                                VerticalAlignment="Center">
                        <Button x:Name="ElementsShortcutButton" Style="{StaticResource ChromeIconButton}"
                                Click="ElementsShortcutButton_Click"
                                AutomationProperties.Name="Elements"
                                AutomationProperties.AutomationId="ShellElementsShortcut"
                                ToolTipService.ToolTip="Elements">
                            <PathIcon Width="16" Height="14"
                                      Data="M 8,0 L 16,14 L 0,14 Z"
                                      Foreground="{ThemeResource SettingsAccentBrush}" />
                        </Button>

                        <Border Style="{StaticResource HeaderToolbarDivider}" />

                        <Button x:Name="ThemeToggleButton" Style="{StaticResource ChromeIconButton}"
                                Click="ThemeToggleButton_Click"
                                AutomationProperties.Name="Toggle theme"
                                AutomationProperties.AutomationId="ShellThemeToggle"
                                ToolTipService.ToolTip="Toggle theme">
                            <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE706;" FontSize="18"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource ShellToolbarIconBrush}" />
                        </Button>

                        <Border Style="{StaticResource HeaderToolbarDivider}" />

                        <Button x:Name="SettingsButton" Style="{StaticResource ChromeIconButton}"
                                Click="SettingsButton_Click"
                                AutomationProperties.Name="Settings"
                                AutomationProperties.AutomationId="ShellSettingsButton"
                                ToolTipService.ToolTip="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="18"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource ShellToolbarIconBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tools stays a 268x340 portrait card. Orbit Settings is the animated hub mark
                     with its title underneath — no plate, only the shared ThemeShadow. Each is a
                     Button so the whole target is keyboard-reachable and announced to Narrator
                     (docs/windows-app-design-standards.md §7.3). -->
                <Grid Grid.Row="1">
                    <!-- What the tiles' ThemeShadow is cast onto. Outside a popup a ThemeShadow
                         draws only onto the elements in its Receivers collection, so a caster with
                         an empty one simply renders no shadow at all. A transparent plate behind
                         the row is the framework's own documented pattern for this; it is
                         hit-test-invisible (Background left unset, not Transparent) so it never
                         intercepts a click meant for the window. -->
                    <Grid x:Name="HomeShadowPlate" />
                <StackPanel Orientation="Horizontal" Spacing="34"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,0,0,24">

                    <Button x:Name="OrbitBox" Padding="0" Background="Transparent"
                            BorderThickness="0" CornerRadius="16"
                            Click="OrbitBox_Click"
                            AutomationProperties.AutomationId="ShellBoxOrbit"
                            AutomationProperties.Name="Orbit Settings">
                        <Border Padding="28,24,28,20" CornerRadius="16" BorderThickness="0"
                                Background="Transparent"
                                Shadow="{StaticResource BoxShadow}" Translation="0,0,24">
                            <StackPanel Spacing="16" HorizontalAlignment="Center">
                                <ContentControl x:Name="HomeOrbitMarkHost" Width="160" Height="160"
                                                HorizontalAlignment="Center" IsTabStop="False" />
                                <TextBlock Text="Orbit Settings" FontSize="22" FontWeight="Bold"
                                           TextAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource SettingsTitleBrush}" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button x:Name="ToolsBox" Padding="0" Background="Transparent"
                            BorderThickness="0" CornerRadius="8"
                            Click="ToolsBox_Click"
                            AutomationProperties.AutomationId="ShellBoxTools"
                            AutomationProperties.Name="Tools">
                        <Border Width="268" Height="340" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource ShellCardBackgroundBrush}"
                                BorderBrush="{ThemeResource ShellCardBorderBrush}"
                                Shadow="{StaticResource BoxShadow}" Translation="0,0,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="0"
                                            Padding="24,0,24,0">
                                    <Grid Width="88" Height="88" HorizontalAlignment="Center"
                                          Margin="0,0,0,24">
                                        <Ellipse Width="88" Height="88"
                                                 Fill="{ThemeResource ShellMedallionBrush}"
                                                 Stroke="{ThemeResource ShellCardBorderBrush}"
                                                 StrokeThickness="1" />
                                        <FontIcon Glyph="&#xE90F;" FontSize="36"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Foreground="{ThemeResource SettingsAccentBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Tools" FontSize="22" FontWeight="Bold"
                                               TextAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource SettingsTitleBrush}" />
                                    <TextBlock Text="Open the built-in developer tools."
                                               Style="{StaticResource SettingBody}"
                                               TextAlignment="Center" Margin="0,10,0,0" />
                                    <Border Height="22" CornerRadius="11"
                                            Padding="12,0" Margin="0,16,0,0"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource ShellPillBrush}">
                                        <TextBlock x:Name="ToolsBoxMeta" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource SettingsSecondaryTextBrush}"
                                                   Text="5 tools" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <Border Height="1" Background="{ThemeResource ShellDividerBrush}" />
                                    <TextBlock Text="OPEN" Style="{StaticResource BoxOpenLabel}"
                                               Margin="0,14,0,16" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>
                </Grid>
            </Grid>

            <!-- ==================================================================
                 ORBIT — Logi's ActionRingPage layout view, measured off
                 docs/images/17-app-ring.svg: a full-bleed canvas column (68px
                 header, the ring, a 60px toolbar over a hairline) beside a fixed
                 320px sidebar, in the ring canvas's own darker palette rather
                 than the app chrome's. See docs/full-app-mockups-logi-base.md
                 for why those are two palettes and not one.

                 Where this departs from Logi: Logi's sidebar is a drag-source
                 accordion and its ring settings live on a separate screen
                 reached by a nav button. SwiftX has one screen, and the sidebar
                 is what changes — orbit settings by default, the add-something
                 accordion once Edit is pressed. Both panels are siblings whose
                 Visibility is swapped (SetOrbitEditing), the same idiom
                 ActionRingPage itself uses to swap its Layout view for its
                 Explore AI view inside one Grid.
                 ================================================================== -->
            <Grid x:Name="OrbitScreen" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Logi's own 320, fixed rather than starred: the sidebar holds a slider and
                         a corner picker with real minimum widths, and letting it shrink on a
                         narrower window would clip those rather than reflow them. The canvas
                         column takes what is left instead — it is drawn to whatever room is left. -->
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{ThemeResource OrbitCanvasBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <!-- Logi's header row: back chevron and title on the left, its layout/profile
                         tabs on the right. SwiftX has no profiles, so the right-hand slot carries
                         the Edit toggle — the one control that changes what the sidebar is. -->
                    <Grid Grid.Row="0" Padding="24,16,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="OrbitTitleBar" Grid.Column="0" Orientation="Horizontal"
                                    Spacing="12" VerticalAlignment="Center">
                            <Button Style="{StaticResource ChromeIconButton}" Click="Back_Click"
                                    AutomationProperties.Name="Home"
                                    ToolTipService.ToolTip="Home">
                                <FontIcon Glyph="&#xE80F;" FontSize="18"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Foreground="{ThemeResource SettingsHeaderBrush}" />
                            </Button>
                            <TextBlock Text="Orbit" Style="{StaticResource ScreenTitle}" />
                        </StackPanel>

                        <!-- The same cell, holding the header a group's own view wears instead
                             (ShowGroupHeader / HideGroupHeader). Opening a group no longer reveals
                             a strip under the canvas — the canvas itself becomes that group's
                             children — so with an unchanged header the two views would be
                             indistinguishable at a glance, and the only way back out would be the
                             bubble you no longer have on screen. The back arrow here returns to
                             the whole orbit rather than to Home, which is what the one above it
                             still does. -->
                        <StackPanel x:Name="OrbitGroupHeader" Grid.Column="0" Visibility="Collapsed"
                                    Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Style="{StaticResource ChromeIconButton}"
                                    Click="OrbitGroupBack_Click"
                                    AutomationProperties.Name="Back to the whole orbit"
                                    ToolTipService.ToolTip="Back to the whole orbit">
                                <FontIcon Glyph="&#xE72B;" FontSize="18"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Foreground="{ThemeResource SettingsHeaderBrush}" />
                            </Button>
                            <FontIcon x:Name="OrbitGroupIcon" FontSize="18" VerticalAlignment="Center"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource OrbitCanvasAccentBrush}"
                                      Tapped="OrbitGroupHeaderTitle_Tapped" />
                            <StackPanel VerticalAlignment="Center"
                                        Tapped="OrbitGroupHeaderTitle_Tapped">
                                <TextBlock Text="GROUP" Style="{StaticResource SidebarEyebrow}" />
                                <TextBlock x:Name="OrbitGroupName" Style="{StaticResource ScreenTitle}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Elements reveals the "ADD TO ORBIT" sidebar (SetOrbitEditing(true))
                             and Settings reveals the orbit's own settings sidebar. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center">
                            <Button x:Name="OrbitElementsButton" Style="{StaticResource ChromeIconButton}"
                                    Click="OrbitElementsButton_Click"
                                    AutomationProperties.Name="Elements"
                                    ToolTipService.ToolTip="Show the things you can put on the orbit">
                                <PathIcon Width="16" Height="14"
                                          Data="M 8,0 L 16,14 L 0,14 Z"
                                          Foreground="{ThemeResource SettingsAccentBrush}" />
                            </Button>
                            <Button x:Name="OrbitSidebarSettingsButton" Style="{StaticResource ChromeIconButton}"
                                    Click="OrbitSidebarSettingsButton_Click"
                                    AutomationProperties.Name="Orbit settings"
                                    ToolTipService.ToolTip="Show the orbit's settings">
                                <FontIcon Glyph="&#xE713;" FontSize="18"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Foreground="{ThemeResource SettingsHeaderBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Two stacked canvases of the same size. PreviewCanvas is the one that has
                         always been here — hub, bubbles, hit-testing, drag — and is untouched by
                         the label pills, which live on their own canvas below it with hit-testing
                         off. That split is what lets a pill sit outboard of a node without ever
                         becoming a drag target or swallowing a press meant for the bubble behind
                         it, and it is why none of the drag code had to learn about pills. -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas x:Name="PreviewCanvas" Width="470" Height="470"
                                Background="Transparent" />
                        <Canvas x:Name="PreviewLabelCanvas" Width="640" Height="470" />
                    </Grid>

                    <!-- Row 2 is deliberately empty and deliberately still here. It used to carry
                         GroupRow, the horizontal strip a clicked group expanded into; a group now
                         takes over the canvas itself (see RenderGroupArc), so there is nothing left
                         to put between the canvas and the toolbar. The Auto row costs nothing while
                         empty and keeps the toolbar's row index where the rest of this screen
                         already expects it. -->

                    <!-- Logi's 60px tools bar. Its controls are Logi's; the commands are SwiftX's,
                         moved down here off the canvas card they used to sit inside. -->
                    <Grid Grid.Row="3" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Spans both columns: the rule is the top edge of the whole bar, not of
                             either half of it. -->
                        <Border Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Height="1"
                                Background="{ThemeResource OrbitCanvasBorderBrush}" />
                        <!-- The bar's left half: the two screen-wide affordances, then what is
                             left of the column for the hint. They sit opposite Add item / Reset
                             defaults rather than beside them because those two act on the orbit's
                             contents and go away with it (a corner preview, a group's children),
                             while a way into Settings and a way into help are wanted from every
                             state this canvas has. Still a Grid rather than one StackPanel so the
                             hint keeps something to trim against — a StackPanel measures its
                             children unbounded along its own axis, and an untrimmed hint on a
                             narrow window would simply run underneath the buttons opposite. -->
                        <Grid Grid.Column="0" Margin="16,0,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- The gear that used to live here now lives in the header (see
                                 OrbitSidebarSettingsButton) and the wrench moved down to
                                 CanvasActions, next to Reset defaults — this StackPanel is left
                                 empty rather than restructuring the Grid around the hint text. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Center" />

                            <TextBlock x:Name="OrbitCanvasHint" Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource SettingsMutedBrush}"
                                       Text="Drag to rearrange · click for details"
                                       ToolTipService.ToolTip="Click an empty slot or + to add; click an item to see its details; click a group to see what's inside; drag an item to rearrange; right-click an item to replace or delete it. The corner button switches to what the hot corner opens, which is arranged the same way." />
                        </Grid>
                        <StackPanel x:Name="CanvasActions" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,24,0">
                            <Button x:Name="AddItemButton" Content="Add item…" Height="30"
                                    CornerRadius="6" Click="AddItem_Click" />
                            <Button Content="Reset defaults" Height="30" CornerRadius="6"
                                    Click="ResetDefaults_Click" />
                            <!-- E90F (Repair) is the wrench in Segoe Fluent Icons. The menu under
                                 it is the reference's How To / Support / What's New, re-pointed at
                                 things SwiftX actually has — see each item's handler for which
                                 reference entry it stands in for. -->
                            <Button x:Name="OrbitHelpButton"
                                    Style="{StaticResource ChromeIconButton}"
                                    AutomationProperties.Name="Help and support"
                                    ToolTipService.ToolTip="Help and support">
                                <FontIcon Glyph="&#xE90F;" FontSize="16"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Foreground="{ThemeResource SettingsHeaderBrush}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="Top">
                                        <MenuFlyoutSubItem Text="How to">
                                            <MenuFlyoutItem Text="Run the set-up guide"
                                                            Click="RunOnboarding_Click" />
                                            <MenuFlyoutItem Text="Choose what goes on the orbit"
                                                            Click="HowToArrange_Click" />
                                            <MenuFlyoutItem Text="Read the handbook"
                                                            Click="HowToHandbook_Click" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem Text="Support" Click="OrbitSupport_Click" />
                                        <MenuFlyoutItem Text="What's new" Click="WhatsNew_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Margin="12,16,16,16" CornerRadius="16"
                        Background="{ThemeResource OrbitSidebarBackgroundBrush}"
                        BorderBrush="{ThemeResource OrbitSidebarBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <!-- ========== Sidebar, default: the orbit's own settings ========== -->
                        <ScrollViewer x:Name="OrbitSidebarSettings" Padding="20,18,14,20"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="18">
                                <TextBlock Text="ORBIT SETTINGS" Style="{StaticResource SidebarEyebrow}" />

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Item size" Style="{StaticResource SidebarHeading}" />
                                    <TextBlock Text="How large orbit items are drawn."
                                               Style="{StaticResource SidebarCaption}" />
                                    <!-- One row, not three stacked. Three choices of one word each
                                         stacked vertically spend sixty pixels of a fixed 320px
                                         column saying what fits comfortably in one line of it, and
                                         the column has a slider, a corner picker and a second
                                         three-way row below competing for the same height.
                                         MinWidth="0" on each is what makes that fit at all —
                                         RadioButton's default style carries a 120px minimum, which
                                         would push the third option off the edge on its own. -->
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                        <RadioButton x:Name="ItemSizeSmallOption" Content="Small" Tag="Small"
                                                     GroupName="ItemSize" MinWidth="0"
                                                     AutomationProperties.Name="Item size: Small"
                                                     Checked="ItemSize_Checked" />
                                        <RadioButton x:Name="ItemSizeMediumOption" Content="Medium" Tag="Medium"
                                                     GroupName="ItemSize" MinWidth="0"
                                                     AutomationProperties.Name="Item size: Medium"
                                                     Checked="ItemSize_Checked" />
                                        <RadioButton x:Name="ItemSizeLargeOption" Content="Large" Tag="Large"
                                                     GroupName="ItemSize" MinWidth="0"
                                                     AutomationProperties.Name="Item size: Large"
                                                     Checked="ItemSize_Checked" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource OrbitSidebarBorderBrush}" />

                                <!-- Size's own axis: how much room an item takes is one question,
                                     what fills that room is another. Built in the same visual
                                     language as the row above rather than as a pill pair or a
                                     dropdown, because it is the same kind of choice — three named
                                     alternatives, exactly one of them true — and two adjacent
                                     settings that read as one thing should not be operated two
                                     different ways. Tag is the OrbitItemShape member name verbatim,
                                     the same contract ItemSize's own Tags carry. -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Item shape" Style="{StaticResource SidebarHeading}" />
                                    <TextBlock Text="The outline each orbit item is drawn with."
                                               Style="{StaticResource SidebarCaption}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                        <RadioButton x:Name="ItemShapeCircleOption" Content="Circle" Tag="Circle"
                                                     GroupName="ItemShape" MinWidth="0"
                                                     AutomationProperties.Name="Item shape: Circle"
                                                     Checked="ItemShape_Checked" />
                                        <RadioButton x:Name="ItemShapeSquircleOption" Content="Squircle" Tag="Squircle"
                                                     GroupName="ItemShape" MinWidth="0"
                                                     AutomationProperties.Name="Item shape: Squircle"
                                                     ToolTipService.ToolTip="A square with its corners rounded off"
                                                     Checked="ItemShape_Checked" />
                                        <RadioButton x:Name="ItemShapeSquareOption" Content="Square" Tag="Square"
                                                     GroupName="ItemShape" MinWidth="0"
                                                     AutomationProperties.Name="Item shape: Square"
                                                     Checked="ItemShape_Checked" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource OrbitSidebarBorderBrush}" />

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Orbit radius" Style="{StaticResource SidebarHeading}" />
                                    <TextBlock Text="Distance from the hub to each item."
                                               Style="{StaticResource SidebarCaption}" />
                                    <Slider x:Name="RadiusSlider" Margin="0,2,0,0"
                                            AutomationProperties.Name="Orbit radius"
                                            Minimum="80" Maximum="220" StepFrequency="5" TickFrequency="20"
                                            ValueChanged="RadiusSlider_ValueChanged" />
                                    <!-- Kept in sync from code (RadiusSlider_ValueChanged) rather
                                         than bound: the slider has no template part that exposes
                                         its value as formatted text. -->
                                    <TextBlock x:Name="RadiusReadout" HorizontalAlignment="Right"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource SettingsTitleBrush}" />
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource OrbitSidebarBorderBrush}" />

                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hot corner"
                                                   Style="{StaticResource SidebarHeading}"
                                                   VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="HotCornerEnabledToggle" Grid.Column="1"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      AutomationProperties.Name="Hot corner"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.AutomationId="SettingsHotCornerToggle"
                                                      Toggled="HotCornerEnabled_Toggled" />
                                    </Grid>
                                    <TextBlock Text="Shove the pointer into a corner to summon the orbit."
                                               Style="{StaticResource SidebarCaption}" />

                                    <!-- Collapsed rather than disabled while the corner is off: the
                                         picker and the layout pair mean nothing then, and a dead
                                         control left sitting in the panel is worse than no control. -->
                                    <StackPanel x:Name="HotCornerOptionsRow" Spacing="10" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="10"
                                                    VerticalAlignment="Center">
                                            <!-- A right-angled triangle standing in for the corner
                                                 itself: the right angle is the corner, the
                                                 hypotenuse the diagonal you cut across to reach it.
                                                 Drawn rather than picked from the icon font because
                                                 no Segoe glyph is a bare right triangle, and because
                                                 a drawn one can be turned — UpdateHotCornerIcon sets
                                                 the rotation from the dropdown, so it always points
                                                 at the corner actually selected. -->
                                            <PathIcon x:Name="HotCornerIcon"
                                                      Data="M 0,0 L 14,0 L 0,14 Z"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                <PathIcon.RenderTransform>
                                                    <RotateTransform x:Name="HotCornerIconRotation" />
                                                </PathIcon.RenderTransform>
                                            </PathIcon>
                                            <ComboBox x:Name="HotCornerBox" MinWidth="0" Width="130"
                                                      VerticalAlignment="Center" CornerRadius="6"
                                                      AutomationProperties.Name="Hot corner position"
                                                      AutomationProperties.AutomationId="SettingsHotCornerBox"
                                                      SelectionChanged="HotCornerBox_SelectionChanged">
                                                <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                                <ComboBoxItem Content="Top right" Tag="TopRight" />
                                                <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                                                <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <RadioButton x:Name="HotCornerLayoutOrbit" Content="Orbit"
                                                         GroupName="HotCornerLayout" MinWidth="0"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.AutomationId="SettingsHotCornerLayoutOrbit"
                                                         Checked="HotCornerLayout_Checked" />
                                            <RadioButton x:Name="HotCornerLayoutQuadrant" Content="Quadrant"
                                                         GroupName="HotCornerLayout" MinWidth="0"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.AutomationId="SettingsHotCornerLayoutQuadrant"
                                                         Checked="HotCornerLayout_Checked" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource OrbitSidebarBorderBrush}" />

                                <!-- A two-segment pill rather than a ComboBox, matching the mockup's
                                     Invert/Zoom toggle — see SelectHoverStyle for why the selected
                                     segment is painted from code (the app's live accent colour, with
                                     a contrast-computed foreground) instead of from a Style. -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Hover style" Style="{StaticResource SidebarHeading}" />
                                    <TextBlock Text="Invert swaps an item's fill under the pointer. Zoom keeps its colour and shrinks it."
                                               Style="{StaticResource SidebarCaption}" />
                                    <Grid ColumnSpacing="8" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Padding="0" Background="Transparent"
                                                BorderThickness="0" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Tag="Invert" Click="HoverStyleOption_Click"
                                                AutomationProperties.Name="Hover style: Invert">
                                            <Border x:Name="HoverStyleInvertPill" CornerRadius="6"
                                                    BorderThickness="1" Padding="0,7">
                                                <TextBlock x:Name="HoverStyleInvertText" Text="Invert"
                                                           HorizontalAlignment="Center" FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Button>
                                        <Button Grid.Column="1" Padding="0" Background="Transparent"
                                                BorderThickness="0" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Tag="Zoom" Click="HoverStyleOption_Click"
                                                AutomationProperties.Name="Hover style: Zoom">
                                            <Border x:Name="HoverStyleZoomPill" CornerRadius="6"
                                                    BorderThickness="1" Padding="0,7">
                                                <TextBlock x:Name="HoverStyleZoomText" Text="Zoom"
                                                           HorizontalAlignment="Center" FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- The read-only InfoBox inspector that used to close this panel is
                                     gone. An item's details are shown on a card anchored to the
                                     item itself now (ShowItemInfo), where the icon it is about is
                                     under the pointer — a panel on the far side of the screen made
                                     you look away from the thing you had just clicked to read its
                                     name back, and had nowhere sensible to put the icon editor the
                                     card carries. -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ========== Sidebar, editing: what you can put on the orbit ========== -->
                        <ScrollViewer x:Name="OrbitSidebarEdit" Visibility="Collapsed"
                                      Padding="20,18,14,20"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <TextBlock Text="ADD TO ORBIT" Style="{StaticResource SidebarEyebrow}" />
                                <TextBlock x:Name="OrbitEditSummary" Style="{StaticResource SidebarCaption}"
                                           TextWrapping="Wrap" />
                                <!-- Categories are built in code (BuildOrbitEditSidebar) because
                                     their rows are data — the apps and folders this machine
                                     actually has, and the tool catalog — not markup. -->
                                <StackPanel x:Name="OrbitEditCategories" Spacing="6" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================================================================
                 TOOLS
                 ================================================================== -->
            <Grid x:Name="ToolsScreen" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                            Padding="24,16,24,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeIconButton}" Click="Back_Click"
                            AutomationProperties.Name="Back to home"
                            ToolTipService.ToolTip="Back to home">
                        <FontIcon Glyph="&#xE72B;" FontSize="18"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource SettingsHeaderBrush}" />
                    </Button>
                    <TextBlock Text="Tools" Style="{StaticResource ScreenTitle}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="48,8,64,48">
                    <!-- Widened from the vertical list's 780 cap: four 224-wide card slots (see
                         ToolsList's ItemsWrapGrid below) need 896px, and the window's own content
                         budget here (1040 client width minus this ScrollViewer's 48+64 padding) is
                         928 — 900 leaves a small margin inside that without being so wide it invites
                         a 5th column if ItemWidth ever changes. -->
                    <StackPanel Spacing="6" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Every tool lives inside the Tools item on the orbit. Open one from here or from the dock."
                                   Style="{StaticResource SettingBody}" Margin="0,0,0,8" />

<!-- Rows are built in code-behind (RebuildToolsList) — one per entry in
                             ToolRows, each shown once here regardless of how many orbit instances
                             it has. Still a ListView rather than a GridView even now that nothing
                             is reorderable: the mockups' card grid is an ItemsWrapGrid ItemsPanel,
                             which a ListView takes as readily (a GridView is literally a ListView
                             with a grid-flavoured panel and container style), and swapping the
                             control would mean rebuilding the ItemsSource binding for no visible
                             change. MaximumRowsOrColumns="4" caps the wrap at four columns outright
                             rather than leaving it to width math, so the fifth ToolRow wraps to its
                             own row instead of ever being dropped. -->
                        <ListView x:Name="ToolsList" SelectionMode="None"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <muxc:ItemsWrapGrid Orientation="Horizontal"
                                                         MaximumRowsOrColumns="4"
                                                         ItemWidth="224" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,24,24" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================================================================
                 ELEMENTS
                 ================================================================== -->
            <Grid x:Name="ElementsScreen" Visibility="Collapsed"
                  AutomationProperties.AutomationId="SettingsAppsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="24,16,24,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource ChromeIconButton}" Click="Back_Click"
                                AutomationProperties.Name="Back to home"
                                ToolTipService.ToolTip="Back to home">
                            <FontIcon Glyph="&#xE72B;" FontSize="18"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource SettingsHeaderBrush}" />
                        </Button>
                        <TextBlock Text="Elements" Style="{StaticResource ScreenTitle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Add item…" VerticalAlignment="Center"
                            CornerRadius="6" Click="AddAppItem_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="48,8,64,48">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Elements are the apps, files, folders, links, and groups you've added to the orbit. Show, hide, or remove items on the orbit. Settings and Close are always on the orbit, so they are not listed here."
                                   Style="{StaticResource SettingBody}" Margin="0,0,0,8" />
                        <Grid x:Name="ItemsList" ColumnSpacing="20" RowSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================================================================
                 SETTINGS — LogiApp/SettingsPage.xaml's own shell, measured value
                 for value: 270px sidebar at 32,24,0,32; a 36x36 back button; the
                 two-line 30/34 editorial title; a nav stack pulled back by the
                 sidebar's own left padding (-32) so the 4px indicator sits flush
                 at x=0; 44px rows over a 4/28/* grid; content at 48,28,64,48
                 capped to 780.
                 ================================================================== -->
            <Grid x:Name="SettingsScreen" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Padding="32,24,0,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="16">
                        <Button Style="{StaticResource ChromeIconButton}" Click="Back_Click"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Back to home"
                                ToolTipService.ToolTip="Back to home">
                            <FontIcon Glyph="&#xE72B;" FontSize="18"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource SettingsHeaderBrush}" />
                        </Button>

                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="SwiftX" Style="{StaticResource EditorialTitle}" />
                            <TextBlock Text="Settings" Style="{StaticResource EditorialTitle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="-32,48,0,0" Orientation="Vertical" Spacing="0">
                        <Button x:Name="NavGeneralButton" Style="{StaticResource RailButton}"
                                Click="NavGeneral_Click"
                                AutomationProperties.AutomationId="SettingsNavGeneral">
                            <Grid Height="44" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavGeneralIndicator" Grid.Column="0" Width="4"
                                        Background="{ThemeResource SettingsNavIndicatorBrush}"
                                        Visibility="Visible" />
                                <TextBlock x:Name="NavGeneralText" Grid.Column="2" Text="GENERAL"
                                           Style="{StaticResource RailLabel}"
                                           Foreground="{ThemeResource SettingsNavActiveBrush}" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavFeedbackButton" Style="{StaticResource RailButton}"
                                Click="NavFeedback_Click"
                                AutomationProperties.AutomationId="SettingsNavFeedback">
                            <Grid Height="44" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavFeedbackIndicator" Grid.Column="0" Width="4"
                                        Background="{ThemeResource SettingsNavIndicatorBrush}"
                                        Visibility="Collapsed" />
                                <TextBlock x:Name="NavFeedbackText" Grid.Column="2"
                                           Text="SUPPORT"
                                           Style="{StaticResource RailLabel}"
                                           Foreground="{ThemeResource SettingsNavInactiveBrush}" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavPrivacyButton" Style="{StaticResource RailButton}"
                                Click="NavPrivacy_Click"
                                AutomationProperties.AutomationId="SettingsNavPrivacy">
                            <Grid Height="44" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavPrivacyIndicator" Grid.Column="0" Width="4"
                                        Background="{ThemeResource SettingsNavIndicatorBrush}"
                                        Visibility="Collapsed" />
                                <TextBlock x:Name="NavPrivacyText" Grid.Column="2"
                                           Text="PRIVACY"
                                           Style="{StaticResource RailLabel}"
                                           Foreground="{ThemeResource SettingsNavInactiveBrush}" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavAboutButton" Style="{StaticResource RailButton}"
                                Click="NavAbout_Click"
                                AutomationProperties.AutomationId="SettingsNavAbout">
                            <Grid Height="44" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavAboutIndicator" Grid.Column="0" Width="4"
                                        Background="{ThemeResource SettingsNavIndicatorBrush}"
                                        Visibility="Collapsed" />
                                <TextBlock x:Name="NavAboutText" Grid.Column="2" Text="ABOUT"
                                           Style="{StaticResource RailLabel}"
                                           Foreground="{ThemeResource SettingsNavInactiveBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" Padding="48,28,64,48"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="780" HorizontalAlignment="Left">

                        <!-- ==================== GENERAL ==================== -->
                        <StackPanel x:Name="GeneralSection" Spacing="6" Visibility="Visible">
                            <TextBlock Text="General" Style="{StaticResource SectionHeader}" />

                            <!-- Shown on the very first run only, and only when there isn't already a
                                 SwiftX shortcut on the desktop (see OrbitManager.Start). An InfoBar
                                 rather than a dialog on purpose: a packaged app can't create the
                                 shortcut at install time, so the offer has to come from inside the
                                 app. Closable, and the "Desktop shortcut" switch below says the same
                                 thing permanently for anyone who dismisses it. -->
                            <InfoBar x:Name="DesktopShortcutOffer"
                                     IsOpen="False" Severity="Informational"
                                     Title="Add SwiftX to your desktop?"
                                     Message="SwiftX lives in the notification area, so it has no taskbar button of its own. A desktop shortcut gives you somewhere to click."
                                     Margin="0,0,0,10">
                                <InfoBar.ActionButton>
                                    <Button Content="Create shortcut" Click="CreateDesktopShortcut_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <!-- Theme: Logi's card picker rather than a ComboBox, at its own
                                 145x130 / 82+46 geometry with 12px gutters — four cards where Logi
                                 has three, because SwiftX carries Midnight as well.
                                 Each card is a Button wrapping the Border rather than Logi's
                                 Tapped-on-a-Border, which is mouse-only: a tapped Border takes no
                                 focus and raises no automation peer, so the picker would have been
                                 unreachable by keyboard and silent to Narrator. Tag values are the
                                 AppTheme member names verbatim — "Black", not "Midnight", because
                                 JsonStringEnumConverter persists that member by name in orbit.json
                                 and renaming it strands every config that already carries it. -->
                            <StackPanel Spacing="14" Margin="0,4,0,18">
                                <TextBlock Text="Colour theme" Style="{StaticResource SettingTitle}" />
                                <!-- A Grid rather than a horizontal StackPanel, with the five columns
                                     starred rather than fixed-width: the settings pane's usable width
                                     varies with the window's actual DPI scale, and a fixed per-card
                                     pixel width that fit at one scale clipped the fifth card at
                                     another. Star columns always divide whatever width is actually
                                     available, so all five stay the same width on one row. Frosted
                                     glass's three frost levels live inside that card's own right
                                     rail rather than on a second row that would stretch only the
                                     fifth column. -->
                                <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" x:Name="ThemeCardSystemButton" Tag="System" Padding="0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="8"
                                            Click="ThemeCard_Click"
                                            AutomationProperties.Name="Follow OS theme"
                                            AutomationProperties.AutomationId="SettingsThemeCardSystem">
                                        <Border x:Name="ThemeCardSystem" HorizontalAlignment="Stretch" Height="108" CornerRadius="8"
                                                Background="{ThemeResource ShellCardBackgroundBrush}"
                                                BorderBrush="{ThemeResource ShellCardBorderBrush}"
                                                BorderThickness="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="66" />
                                                    <RowDefinition Height="42" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" CornerRadius="7,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#BACEE4">
                                                        <Border Margin="14,14,-6,0" CornerRadius="4,0,0,0"
                                                                Background="#FFFFFF" Padding="6,8,0,0">
                                                            <StackPanel Spacing="4">
                                                                <Border Height="3" Width="30" CornerRadius="1.5"
                                                                        Background="#6C47FF" HorizontalAlignment="Left" />
                                                                <Border Height="3" Width="20" CornerRadius="1.5"
                                                                        Background="#CCCCCC" HorizontalAlignment="Left" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#243447">
                                                        <Border Margin="-6,14,14,0" CornerRadius="0,4,0,0"
                                                                Background="#1A1A1A" Padding="0,8,6,0">
                                                            <StackPanel Spacing="4" Margin="6,0,0,0">
                                                                <Border Height="3" Width="22" CornerRadius="1.5"
                                                                        Background="#8A67FF" HorizontalAlignment="Left" />
                                                                <Border Height="3" Width="30" CornerRadius="1.5"
                                                                        Background="#555555" HorizontalAlignment="Left" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                                <Grid Grid.Row="1" Padding="10,0,10,0">
                                                    <TextBlock Text="Follow OS&#x0a;Theme" FontSize="11"
                                                               FontWeight="SemiBold" LineHeight="13"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource SettingsTitleBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="1" x:Name="ThemeCardLightButton" Tag="Light" Padding="0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="8"
                                            Click="ThemeCard_Click"
                                            AutomationProperties.Name="Light theme"
                                            AutomationProperties.AutomationId="SettingsThemeCardLight">
                                        <Border x:Name="ThemeCardLight" HorizontalAlignment="Stretch" Height="108" CornerRadius="8"
                                                Background="{ThemeResource ShellCardBackgroundBrush}"
                                                BorderBrush="{ThemeResource ShellCardBorderBrush}"
                                                BorderThickness="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="66" />
                                                    <RowDefinition Height="42" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#CADDF3" CornerRadius="7,7,0,0">
                                                    <Border Margin="18,14,18,0" CornerRadius="4,4,0,0"
                                                            Background="#FFFFFF" Padding="8,8,8,0">
                                                        <StackPanel Spacing="5">
                                                            <Border Height="3" Width="28" CornerRadius="1.5"
                                                                    Background="#6C47FF" HorizontalAlignment="Left" />
                                                            <Border Height="3" Width="38" CornerRadius="1.5"
                                                                    Background="#DDDDDD" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                                <Grid Grid.Row="1" Padding="10,0,10,0">
                                                    <TextBlock Text="Light Theme" FontSize="11"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource SettingsTitleBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="2" x:Name="ThemeCardDarkButton" Tag="Dark" Padding="0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="8"
                                            Click="ThemeCard_Click"
                                            AutomationProperties.Name="Dark theme"
                                            AutomationProperties.AutomationId="SettingsThemeCardDark">
                                        <Border x:Name="ThemeCardDark" HorizontalAlignment="Stretch" Height="108" CornerRadius="8"
                                                Background="{ThemeResource ShellCardBackgroundBrush}"
                                                BorderBrush="{ThemeResource ShellCardBorderBrush}"
                                                BorderThickness="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="66" />
                                                    <RowDefinition Height="42" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#1D2A3A" CornerRadius="7,7,0,0">
                                                    <Border Margin="18,14,18,0" CornerRadius="4,4,0,0"
                                                            Background="#141414" Padding="8,8,8,0">
                                                        <StackPanel Spacing="5">
                                                            <Border Height="3" Width="28" CornerRadius="1.5"
                                                                    Background="#8A67FF" HorizontalAlignment="Left" />
                                                            <Border Height="3" Width="38" CornerRadius="1.5"
                                                                    Background="#3E3E3E" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                                <Grid Grid.Row="1" Padding="10,0,10,0">
                                                    <TextBlock Text="Dark Theme" FontSize="11"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource SettingsTitleBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="3" x:Name="ThemeCardBlackButton" Tag="Black" Padding="0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="8"
                                            Click="ThemeCard_Click"
                                            AutomationProperties.Name="Midnight theme"
                                            AutomationProperties.AutomationId="SettingsThemeCardMidnight">
                                        <Border x:Name="ThemeCardBlack" HorizontalAlignment="Stretch" Height="108" CornerRadius="8"
                                                Background="{ThemeResource ShellCardBackgroundBrush}"
                                                BorderBrush="{ThemeResource ShellCardBorderBrush}"
                                                BorderThickness="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="66" />
                                                    <RowDefinition Height="42" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="7,7,0,0">
                                                    <Border Margin="18,14,18,0" CornerRadius="4,4,0,0"
                                                            Background="#000000" Padding="8,8,8,0">
                                                        <StackPanel Spacing="5">
                                                            <Border Height="3" Width="28" CornerRadius="1.5"
                                                                    Background="#8A67FF" HorizontalAlignment="Left" />
                                                            <Border Height="3" Width="38" CornerRadius="1.5"
                                                                    Background="#2A2A2A" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                                <Grid Grid.Row="1" Padding="10,0,10,0">
                                                    <TextBlock Text="Midnight" FontSize="11"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource SettingsTitleBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <!-- Frosted glass. The preview has to show something *behind*
                                         the window, because that is the whole of what this theme
                                         is: a two-tone ground stands in for a wallpaper, and the
                                         plate over it carries the same low-alpha wash and thin
                                         white edge FrostedGlassPalette computes for the real
                                         surfaces (#59181820 over #3BFFFFFF, its card pair at the
                                         backdrop's own 0.65 opacity). Hard-coded here rather than
                                         bound, like every other card's swatch: a preview has to
                                         look like its theme whichever theme is currently on. -->
                                    <Grid Grid.Column="4">
                                    <Button x:Name="ThemeCardFrostedButton" Tag="FrostedGlass" Padding="0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="8"
                                            HorizontalAlignment="Stretch"
                                            Click="ThemeCard_Click"
                                            AutomationProperties.Name="Frosted glass theme"
                                            AutomationProperties.AutomationId="SettingsThemeCardFrosted">
                                        <Border x:Name="ThemeCardFrosted" HorizontalAlignment="Stretch" Height="108" CornerRadius="8"
                                                Background="{ThemeResource ShellCardBackgroundBrush}"
                                                BorderBrush="{ThemeResource ShellCardBorderBrush}"
                                                BorderThickness="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="66" />
                                                    <RowDefinition Height="42" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" CornerRadius="7,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#2A4C7D" />
                                                    <Border Grid.Column="1" Background="#7A3C6E" />
                                                    <Border Grid.Column="0" Grid.ColumnSpan="2"
                                                            x:Name="ThemeCardFrostedPreview"
                                                            Margin="12,14,12,0" CornerRadius="4,4,0,0"
                                                            Background="#59181820"
                                                            BorderBrush="#3BFFFFFF"
                                                            BorderThickness="1,1,1,0"
                                                            Padding="8,8,8,0">
                                                        <StackPanel Spacing="5">
                                                            <Border Height="3" Width="28" CornerRadius="1.5"
                                                                    Background="#8A67FF" HorizontalAlignment="Left" />
                                                            <Border Height="3" Width="38" CornerRadius="1.5"
                                                                    Background="#66FFFFFF" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Grid Grid.Row="1" Padding="10,0,10,0">
                                                    <TextBlock x:Name="ThemeCardFrostedLabel" Text="Frosted glass" FontSize="11"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource SettingsTitleBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <!-- Overlayed on the card's right edge so the three frost
                                         levels sit inside the tile without nesting Buttons.
                                         Dark at the top, Light at the bottom. Shown only while
                                         Frosted glass is selected (UpdateFrostedLevelSelection). -->
                                    <StackPanel x:Name="FrostedLevelPanel"
                                                Orientation="Vertical" Spacing="6"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,8,8,8" Visibility="Collapsed">
                                        <Button Padding="0" Background="Transparent" BorderThickness="0"
                                                Tag="Dark" Click="FrostedLevel_Click"
                                                AutomationProperties.Name="Frost: Dark"
                                                AutomationProperties.AutomationId="SettingsFrostDark"
                                                ToolTipService.ToolTip="Dark">
                                            <Border x:Name="FrostedLevelDarkPill" Width="18" Height="18"
                                                    CornerRadius="9"
                                                    Background="#2A2A2A" BorderThickness="1.5" />
                                        </Button>
                                        <Button Padding="0" Background="Transparent" BorderThickness="0"
                                                Tag="Medium" Click="FrostedLevel_Click"
                                                AutomationProperties.Name="Frost: Medium"
                                                AutomationProperties.AutomationId="SettingsFrostMedium"
                                                ToolTipService.ToolTip="Medium">
                                            <Border x:Name="FrostedLevelMediumPill" Width="18" Height="18"
                                                    CornerRadius="9"
                                                    Background="#9A9A9A" BorderThickness="1.5" />
                                        </Button>
                                        <Button Padding="0" Background="Transparent" BorderThickness="0"
                                                Tag="Light" Click="FrostedLevel_Click"
                                                AutomationProperties.Name="Frost: Light"
                                                AutomationProperties.AutomationId="SettingsFrostLight"
                                                ToolTipService.ToolTip="Light">
                                            <Border x:Name="FrostedLevelLightPill" Width="18" Height="18"
                                                    CornerRadius="9"
                                                    Background="#E8E8E8" BorderThickness="1.5" />
                                        </Button>
                                    </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <!-- Sits right under Theme: both are how this window looks, not how it
                                 behaves. Show or hide the orbit from the keyboard — the first thing
                                 under Theme because, next to how the window looks, it's how you
                                 summon it at all. -->
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE765;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Invoke" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="Show or hide the orbit from the keyboard."
                                                   Style="{StaticResource SettingBody}" />
                                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource SettingBody}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <controls:HotkeyCaptureButton x:Name="HotkeyCapture"
                                                                      VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="HotkeyEnabledToggle"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      AutomationProperties.Name="Keyboard shortcut"
                                                      VerticalAlignment="Center"
                                                      Toggled="HotkeyEnabled_Toggled" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Language on the left, Accent colour on the right: each is a
                                 single row of icon, title, and control — no body copy. -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE774;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Language" Style="{StaticResource SettingTitle}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="LanguageBox" Grid.Column="2" MinWidth="170" Width="170"
                                                  Height="38" CornerRadius="6"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="SettingsLanguageBox"
                                                  SelectionChanged="LanguageBox_SelectionChanged" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE790;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Accent colour" Style="{StaticResource SettingTitle}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2" x:Name="AccentColorSwatch"
                                                Width="32" Height="32" Padding="0" CornerRadius="16"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Accent colour"
                                                AutomationProperties.AutomationId="SettingsAccentColorSwatch">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Spacing="10" MinWidth="260">
                                                        <ColorPicker x:Name="AccentColorPicker"
                                                                     IsAlphaEnabled="False"
                                                                     AutomationProperties.Name="Accent colour picker"
                                                                     ColorChanged="AccentColorPicker_ColorChanged" />
                                                        <Button Content="Reset to default" HorizontalAlignment="Stretch"
                                                                AutomationProperties.AutomationId="SettingsAccentColorReset"
                                                                Click="ResetAccentColor_Click" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE7E8;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Start with Windows"
                                                   Style="{StaticResource SettingTitle}"
                                                   VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="2"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      AutomationProperties.Name="Start with Windows"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Toggled="StartupToggle_Toggled" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8FC;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Desktop shortcut"
                                                   Style="{StaticResource SettingTitle}"
                                                   VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="DesktopShortcutToggle" Grid.Column="2"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      AutomationProperties.Name="Desktop shortcut"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Toggled="DesktopShortcutToggle_Toggled" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8C8;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Backup" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="Export or import your orbit as JSON."
                                                       Style="{StaticResource SettingBody}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Content="Export…" CornerRadius="6" Click="Export_Click" />
                                            <Button Content="Import…" CornerRadius="6" Click="Import_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE777;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Reset" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="Restore default theme, accent, orbit and tools."
                                                       Style="{StaticResource SettingBody}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Reset" VerticalAlignment="Center"
                                                CornerRadius="6" Click="ResetAll_Click" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ==================== SUPPORT ==================== -->
                        <StackPanel x:Name="FeedbackSection" Spacing="20" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="SettingsFeedbackPanel">
                            <TextBlock Text="Support" Style="{StaticResource SectionHeader}" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Set-up guide" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Style="{StaticResource SettingBody}"
                                           Text="The same three steps the first launch walks through:" />
                                <TextBlock Style="{StaticResource SettingBody}"
                                           Text="1. Welcome — SwiftX is a quick-access orbit for the apps, folders, links and tools you reach for most." />
                                <TextBlock Style="{StaticResource SettingBody}"
                                           Text="2. Pick what sits on the orbit. You can change this later from Orbit Settings." />
                                <TextBlock Style="{StaticResource SettingBody}"
                                           Text="3. Choose the keyboard shortcut that summons it, and whether a screen corner should do it too." />
                                <Button Content="Open guide" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        CornerRadius="6"
                                        AutomationProperties.AutomationId="SettingsRunOnboarding"
                                        Click="RunOnboarding_Click" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Troubleshooting and Support" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Text="Report issues or request support."
                                           Style="{StaticResource SettingBody}" />
                                <HyperlinkButton Content="REPORT ISSUES / REQUEST SUPPORT"
                                                 Style="{StaticResource AccentLink}"
                                                 Margin="0,4,0,0" HorizontalAlignment="Left"
                                                 AutomationProperties.AutomationId="SettingsFeedbackSupport"
                                                 Click="ReportIssue_Click" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SettingBody}" FontStyle="Italic"
                                       Margin="0,4,0,0">
                                <Run Text="Links open in your browser, SwiftX sends nothing on its own." />
                                <Hyperlink x:Name="ReadPrivacyLink"
                                           Click="OpenPrivacyFromFeedback_Click"
                                           UnderlineStyle="None">Read privacy</Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- ==================== PRIVACY ==================== -->
                        <!-- Written to say what happens to the user's data, not where the bytes sit.
                             Logi's own Privacy section is two telemetry toggles and an EULA link;
                             SwiftX has no telemetry to toggle, and a switch here would contradict
                             the copy below, so the section keeps SwiftX's content in Logi's shape. -->
                        <StackPanel x:Name="PrivacySection" Spacing="20" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="SettingsPrivacyPanel">
                            <TextBlock Text="Privacy" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,4" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Everything stays on this device" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Text="Your orbit items and settings are saved to this PC only. There is no SwiftX account and no server to sync to."
                                           Style="{StaticResource SettingBody}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="No tracking, no analytics" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Text="SwiftX collects no usage data, sends no crash or telemetry reports, and shows no ads."
                                           Style="{StaticResource SettingBody}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Secure values are encrypted for your account" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Text="Anything kept in Secure values is protected by Windows' own per-user encryption, so it can only be read back while you are signed in to this account on this device."
                                           Style="{StaticResource SettingBody}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="The tools run offline" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Text="Text you paste and files you open in the built-in tools are processed on this device and are never uploaded anywhere."
                                           Style="{StaticResource SettingBody}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="The one thing that touches the network" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Text="A web link on the orbit may ask that site for its icon so the item can show it. That request carries nothing about you, and it is the only network call SwiftX makes on its own."
                                           Style="{StaticResource SettingBody}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="You can take it all back" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Text="Export your setup at any time from General, and Reset clears it back to defaults."
                                           Style="{StaticResource SettingBody}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Your rating stays here" Style="{StaticResource PrivacyHeading}" />
                                <TextBlock Text="The star rating on About is saved to this PC with the rest of your settings. It is not sent anywhere, and the feedback links simply open your browser — nothing you write there passes through SwiftX."
                                           Style="{StaticResource SettingBody}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== ABOUT ==================== -->
                        <!-- Logi's About is a hero card, a spec card and a legal-notices row. The
                             hero card is ported at Logi's own geometry (CornerRadius 12, Padding 24,
                             90/* columns, 18/13/12 type). The spec card is ported too, with SwiftX's
                             own four honest rows. Its label column is Auto + MinWidth rather than
                             Logi's fixed 160: a fixed width clips a longer localised label at 200%
                             scaling. -->
                        <StackPanel x:Name="AboutSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="About" Style="{StaticResource SectionHeader}" />

                            <Border Background="{ThemeResource ShellCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource ShellCardBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="24"
                                    Margin="0,0,0,18">
                                <!-- Grid rather than a horizontal StackPanel: the paragraphs below
                                     wrap, and a StackPanel would measure them against infinite width
                                     so they never would. AboutMark is filled in from code-behind
                                     because the app mark is vector geometry built by AppLogo, not a
                                     bitmap. -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="AboutMark" Grid.Column="0"
                                                    VerticalAlignment="Center" IsTabStop="False" />
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="SwiftX" FontSize="18" FontWeight="Bold"
                                                   Foreground="{ThemeResource SettingsTitleBrush}" />
                                        <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SettingsAccentBrush}" />
                                        <TextBlock Style="{StaticResource SettingBody}"
                                                   Text="A quick-access orbit for Windows. Summon it with a shortcut, a screen corner, or the tray icon, and launch the apps, folders, links, and built-in tools you reach for most." />
                                        <TextBlock Style="{StaticResource SettingBody}"
                                                   Text="SwiftX runs entirely on your own device — see Privacy for what that means." />
                                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,4,0,0">
                                            <HyperlinkButton Content="TERMS AND CONDITIONS"
                                                             Style="{StaticResource AccentLink}"
                                                             AutomationProperties.AutomationId="SettingsAboutTerms"
                                                             Click="OpenTerms_Click" />
                                            <HyperlinkButton Content="PRIVACY"
                                                             Style="{StaticResource AccentLink}"
                                                             AutomationProperties.AutomationId="SettingsAboutPrivacy"
                                                             Click="OpenPrivacyFromAbout_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE939;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                              VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="General Feedback" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="How's your experience with SwiftX so far? We'd love to hear your thoughts. Your feedback helps make SwiftX better."
                                                   Style="{StaticResource SettingBody}" />
                                        <HyperlinkButton Content="SHARE GENERAL FEEDBACK"
                                                         Style="{StaticResource AccentLink}"
                                                         Margin="0,8,0,0" HorizontalAlignment="Left"
                                                         AutomationProperties.AutomationId="SettingsFeedbackShare"
                                                         Click="ShareFeedback_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE734;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                              VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Rate your experience" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="Take a moment to rate your experience with SwiftX. The stars are saved on this device and are never sent anywhere — the links below are where a rating actually reaches us."
                                                   Style="{StaticResource SettingBody}" />
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                            <muxc:RatingControl x:Name="ExperienceRating"
                                                                VerticalAlignment="Center"
                                                                IsClearEnabled="True"
                                                                AutomationProperties.Name="Rate your experience"
                                                                AutomationProperties.AutomationId="SettingsFeedbackRating" />
                                            <TextBlock x:Name="RatingThanks" Visibility="Collapsed"
                                                       Style="{StaticResource SettingBody}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10,0,0">
                                            <HyperlinkButton Content="RATE ON MICROSOFT STORE"
                                                             Style="{StaticResource AccentLink}"
                                                             AutomationProperties.AutomationId="SettingsFeedbackRateStore"
                                                             Click="RateOnStore_Click" />
                                            <HyperlinkButton Content="STAR US ON GITHUB"
                                                             Style="{StaticResource AccentLink}"
                                                             AutomationProperties.AutomationId="SettingsFeedbackStarGitHub"
                                                             Click="StarOnGitHub_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{ThemeResource ShellCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource ShellCardBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="System &amp; runtime" Style="{StaticResource SettingTitle}" />
                                    <Grid ColumnSpacing="16" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows" FontSize="12"
                                                   Foreground="{ThemeResource SettingsMutedBrush}" />
                                        <TextBlock x:Name="SpecOs" Grid.Row="0" Grid.Column="1" FontSize="12"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SettingsTitleBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="UI framework" FontSize="12"
                                                   Foreground="{ThemeResource SettingsMutedBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="WinUI 3 (Windows App SDK)"
                                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SettingsTitleBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Managed runtime" FontSize="12"
                                                   Foreground="{ThemeResource SettingsMutedBrush}" />
                                        <TextBlock x:Name="SpecRuntime" Grid.Row="2" Grid.Column="1" FontSize="12"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SettingsTitleBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Distribution" FontSize="12"
                                                   Foreground="{ThemeResource SettingsMutedBrush}" />
                                        <TextBlock x:Name="SpecDistribution" Grid.Row="3" Grid.Column="1" FontSize="12"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SettingsTitleBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
