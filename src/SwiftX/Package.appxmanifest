<?xml version="1.0" encoding="utf-8"?>
<!--
  Enables single-project MSIX packaging: this file plus EnableMsixTooling (already set in
  SwiftX.csproj) is all a WindowsPackageType=MSIX build needs — no separate packaging project.
  Everyday dev builds are untouched: WindowsPackageType still defaults to None (unpackaged,
  `dotnet run`), so this manifest is only consulted when a packaging build explicitly requests
  MSIX — see the README's "Packaging for the Microsoft Store" section.

  Identity below is this app's actual Partner Center reservation, not a placeholder — Name and
  Publisher must match the reservation exactly, character for character, or Store ingestion
  rejects the upload.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="44492ajaykontham.SwiftX"
    Publisher="CN=93C75305-77D7-448E-B1C4-591A0E9665E1"
    Version="2.0.4.0" />

  <Properties>
    <DisplayName>SwiftX</DisplayName>
    <PublisherDisplayName>ajaykontham</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- Windows.FullTrustApplication, not a plain WinRT entry point: SwiftX P/Invokes Win32
         directly for its hit-test regions, global hotkey, hot-corner polling and tray icon
         (see Interop/NativeMethods.cs), which only a full-trust package can do. -->
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Windows.FullTrustApplication">
      <!-- BackgroundColor is the fill of the *plate* Windows draws behind a plated app icon, and
           "transparent" is why an installed SwiftX used to sit on a blue square in the taskbar and
           Start: with no colour of its own declared, Windows falls back to the user's accent
           colour, which is blue on a default install. The fix is not a different colour here — it
           is the altform-unplated / altform-lightunplated variants of Square44x44Logo now shipped
           in Images\ (written by tools/generate-brand-assets.py), which the taskbar, Start's app
           list, Alt-Tab and Task View use in preference to anything plated, drawing the mark
           straight onto their own surface with no plate at all.

           So "transparent" stays, and is now right rather than merely harmless: what it still
           governs is the Start *tile*, where a transparent background lets the Start menu's own
           acrylic show through behind the mark instead of boxing it in a brand-coloured square. -->
      <uap:VisualElements
        DisplayName="SwiftX"
        Description="A quick-access orbit for Windows 11."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" Square310x310Logo="Images\Square310x310Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
