<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwiftX.OrbitWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SwiftX">
    <Grid x:Name="Root" Background="Transparent" KeyDown="Root_KeyDown">
        <!-- The window spans the whole work area and the orbit is positioned inside the canvas, so
             the canvas must sit at the origin rather than being centered by the Grid. -->
        <!-- Named for Narrator: without it the orbit is an anonymous canvas, so a screen reader
             announces nothing at all for the surface the bubbles inside it live on. The bubbles
             get their own names in CreateBubble (see NameForNarrator). -->
        <Canvas x:Name="OrbitCanvas" Background="Transparent"
                AutomationProperties.Name="SwiftX orbit"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                PointerPressed="OrbitCanvas_PointerPressed"
                PointerMoved="OrbitCanvas_PointerMoved"
                PointerExited="OrbitCanvas_PointerExited"/>
    </Grid>
</Window>
