<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwiftX.AddItemWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add to orbit">

    <!-- AllowDrop lives on Root alone, and that is what makes a drop land anywhere on the dialog
         rather than only on its bare background: no descendant here sets AllowDrop (WinUI's own
         TextBox/Button/ToggleButton styles all leave it False), so the framework's search for a
         drop target walks up from whatever the pointer is over and always arrives here. Root
         itself is hit-testable because it has a Background; the inner Grid has none, so even the
         gaps between controls resolve to Root. -->
    <Grid x:Name="Root" Background="{ThemeResource SwiftXDialogSurfaceBrush}"
          AllowDrop="True" DragEnter="Root_DragEnter" DragOver="Root_DragOver"
          DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar is the shared Controls.AppTitleBar (same one ToolWindowBase uses), built in
             code-behind because its constructor takes glyph/title and XAML object elements need a
             parameterless constructor. -->

        <Grid x:Name="Body" Grid.Row="1" Padding="24,8,24,20" RowSpacing="14">
            <!-- Every row is Auto, including the form: nothing stretches, so no row can quietly
                 accumulate the window's spare height into a gap above the buttons. The window is
                 then sized to exactly what these rows measure — see FitWindowToContent — which is
                 what keeps the Cancel/Add pair sitting just under the last field in every state. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
                <Border Width="44" Height="44" CornerRadius="10"
                        Background="{ThemeResource SwiftXForegroundBrush}">
                    <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="22" Foreground="{ThemeResource SwiftXSurfaceBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Text="Add to orbit" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Choose a type, then set a target and name."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SwiftXMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="What are you adding?" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <!-- Eight tiles (seven types plus the Drag 'n Drop one at the end) in one row that
                     never wraps, so their width times eight plus their spacing times seven has to
                     fit inside AddItemWindow.ClientWidthDip (760) minus Body's own left/right
                     Padding (24+24). That is 712dip to spend. At the 88dip width these tiles used
                     to have, eight of them plus spacing came to 760 — already the full window width
                     before Body's padding was even subtracted — and the row spilled past the edge
                     with no wrap to catch it, which is what "Drag 'n Drop" overlapping the window
                     edge actually was. 80dip leaves 16dip of slack instead. If an eighth — sorry,
                     ninth — tile is ever added here, this arithmetic has to be redone rather than
                     assumed to still hold. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="AppType" Click="TypeSelected" Width="80" Height="80" Padding="4,0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="App">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" />
                            <TextBlock Text="App" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FileType" Click="TypeSelected" Width="80" Height="80" Padding="4,0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="File">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" />
                            <TextBlock Text="File" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FolderType" Click="TypeSelected" Width="80" Height="80" Padding="4,0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="Folder">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" />
                            <TextBlock Text="Folder" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LinkType" Click="TypeSelected" Width="80" Height="80" Padding="4,0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="Web link">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" />
                            <TextBlock Text="Link" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ShortcutType" Click="TypeSelected" Width="80" Height="80" Padding="4,0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="Shortcut">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" />
                            <TextBlock Text="Shortcut" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="GroupType" Click="TypeSelected" Width="80" Height="80" Padding="4,0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="Group">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE838;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" />
                            <TextBlock Text="Group" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolType" Click="TypeSelected" Width="80" Height="80" Padding="4,0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="Tool">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE90F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" />
                            <TextBlock Text="Tool" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Not a type, so deliberately not a ToggleButton: it sits in this row because
                         this is where the eye already is when deciding what to add, but nothing
                         about it is selectable and it must never look picked. A Border shaped like
                         its neighbours reads as "one more way in" without joining the group.

                         Glyph E896 is an arrow descending into a tray — the intake mark — which
                         says "put something in here" rather than "download".

                         Hit-test invisible so it can never swallow the drop it advertises: AllowDrop
                         lives on Root alone (see Root's own comment), and the drop target is the
                         whole window, not this tile. Accent colours come from
                         ApplyAccentColorOverride, the same accent the tiles and Add button use. -->
                    <Border x:Name="DragDropTile" Width="80" Height="80" CornerRadius="4"
                            BorderThickness="1" Padding="4,0" IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="DragDropTileGlyph" Glyph="&#xE896;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" />
                            <TextBlock x:Name="DragDropTileText" Text="Drag 'n Drop"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="12" VerticalAlignment="Top">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TargetLabel" Text="Path or command" />
                    <Grid x:Name="TargetRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox" Grid.Column="0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=TargetLabel}"
                                 PlaceholderText="Choose a file, folder, URL, or path"
                                 TextChanged="TargetBox_TextChanged" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…"
                                Click="Browse_Click" />
                    </Grid>
                    <TextBlock x:Name="TargetHint"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SwiftXMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="NamePanel" Spacing="6">
                    <TextBlock Text="Display name" />
                    <TextBox x:Name="NameBox" PlaceholderText="Shown on the orbit"
                             AutomationProperties.Name="Display name" />
                </StackPanel>

                <StackPanel x:Name="ToolPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Tool" />
                    <ComboBox x:Name="ToolBox" Width="280"
                              AutomationProperties.Name="Tool">
                        <ComboBoxItem Content="Data" Tag="Data" IsSelected="True" />
                        <ComboBoxItem Content="Quick Format" Tag="QuickFormat" />
                        <ComboBoxItem Content="Secure values" Tag="SecureValues" />
                        <ComboBoxItem Content="Base64" Tag="Base64" />
                        <ComboBoxItem Content="Certificate" Tag="Certificate" />
                    </ComboBox>
                </StackPanel>

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="96" Click="Cancel_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="ConfirmButton" Content="Add" MinWidth="140"
                        Style="{ThemeResource AccentButtonStyle}" Click="Add_Click" />
            </StackPanel>
        </Grid>

        <!-- Drag-over affordance. Until this existed the window gave no sign whatsoever that it
             would accept a drop: the form only changed once the item had already landed, so the
             feature was invisible to anyone who hadn't been told about it.

             Spans both rows so the accent rim frames the whole dialog, and IsHitTestVisible is
             False so it takes no part in hit-testing — otherwise it would sit between the pointer
             and Root and start generating DragLeave/DragEnter churn against the very handler that
             shows it, and it would also cover the custom title bar's own buttons.

             Every colour here is assigned from AddItemWindow.ApplyAccentColorOverride, not from a
             ThemeResource: it is the same accent the Add button and the type tiles now use, and
             the pill's label is black or white by the accent's own luminance. -->
        <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2" Margin="6"
                CornerRadius="12" BorderThickness="2"
                Visibility="Collapsed" IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw">
            <Border x:Name="DropPill" CornerRadius="18" Padding="18,10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="DropPillGlyph" Glyph="&#xE710;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="DropPillText" Text="Drop to add to the orbit"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
