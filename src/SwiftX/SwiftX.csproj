<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SwiftX</RootNamespace>
    <AssemblyName>SwiftX</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SwiftX.ico</ApplicationIcon>

    <Platforms>x64;ARM64</Platforms>
    <SwiftXArchitecture Condition="'$(Platform)' == 'ARM64'">arm64</SwiftXArchitecture>
    <SwiftXArchitecture Condition="'$(SwiftXArchitecture)' == ''">x64</SwiftXArchitecture>
    <RuntimeIdentifier>win-$(SwiftXArchitecture)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>

    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <Product>SwiftX</Product>
    <Company>SwiftX</Company>
    <Authors>SwiftX</Authors>
    <Description>A quick-access ring for Windows 11.</Description>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
