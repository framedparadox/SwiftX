<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SwiftX</RootNamespace>
    <AssemblyName>SwiftX</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SwiftX.ico</ApplicationIcon>

    <Platforms>x64;ARM64</Platforms>
    <SwiftXArchitecture Condition="'$(Platform)' == 'ARM64'">arm64</SwiftXArchitecture>
    <SwiftXArchitecture Condition="'$(SwiftXArchitecture)' == ''">x64</SwiftXArchitecture>
    <RuntimeIdentifier>win-$(SwiftXArchitecture)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Unpackaged by default so `dotnet build`/`dotnet run` stay exactly as documented in the
         README's dev loop. A packaging build overrides this from the command line
         (-p:WindowsPackageType=MSIX) to produce a Store-ready MSIX from Package.appxmanifest —
         see the README's "Packaging for the Microsoft Store" section. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <Product>SwiftX</Product>
    <Company>SwiftX</Company>
    <Authors>SwiftX</Authors>
    <Description>A quick-access orbit for Windows 11.</Description>
    <Version>3.0.0.0</Version>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole Images tree, wildcarded, which is what lets tools/generate-brand-assets.py add
         to the set without this file changing: the altform-unplated / altform-lightunplated
         variants of Square44x44Logo land here and are picked up for the MSIX resource index by
         name, the same way every other qualified asset in the folder is. -->
    <Content Include="Images\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Also shipped as a loose file, not only embedded as <ApplicationIcon>: a .lnk can point at
         an icon resource but not at a .png, so the desktop shortcut the packaged build writes
         needs a real .ico on disk to name. See Services/DesktopShortcutService.cs. -->
    <Content Include="Assets\SwiftX.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test assembly reach the handful of guards that are worth asserting directly but
         have no business on the public surface — IconService's bounded response reader chief
         among them, since it is the only place SwiftX reads bytes whose length a remote party
         chooses. -->
    <InternalsVisibleTo Include="SwiftX.Tests" />
  </ItemGroup>

</Project>
