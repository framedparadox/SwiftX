<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwiftX.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SwiftX.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="SwiftX Settings">

    <!-- WinUI Window has no Resources; shared styles live on the root Grid. SettingsSurfaceBrush,
         not the shared SwiftXSurfaceBrush: AddItemWindow and the tool windows also key off
         SwiftXSurfaceBrush and must keep its #000000 Dark value, so Settings' own lighter,
         design-colours.md-anchored surface (#202020) lives under a Settings-exclusive name instead
         of changing that shared one out from under them. -->
    <Grid x:Name="Root" Background="{ThemeResource SettingsSurfaceBrush}">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SwiftXCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SwiftXCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <!-- ThemeResource inside a Style resolves against the element the style lands on,
                 so Light Settings never paints Dark secondary text into a white card. -->
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SwiftXMutedBrush}" />
            </Style>
            <Style x:Key="SecondaryCaption" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SwiftXMutedBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar is the shared Controls.AppTitleBar (same one ToolWindowBase uses), built in
             code-behind because its constructor takes glyph/title and XAML object elements need a
             parameterless constructor. -->

        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="Collapsed"
                             IsTitleBarAutoPaddingEnabled="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="home" IsSelected="True"
                                         AutomationProperties.AutomationId="SettingsNavHome">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="General" Tag="general"
                                         AutomationProperties.AutomationId="SettingsNavGeneral">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Elements" Tag="apps"
                                         AutomationProperties.AutomationId="SettingsNavApps">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Tools" Tag="tools"
                                         AutomationProperties.AutomationId="SettingsNavTools">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <!-- Pinned below the scrollable menu, separated by NavigationView's own divider —
                 both read as the same "learn more" footer slot Windows apps usually give
                 Settings/About rather than just another row in the working-page list above, About
                 first as the more general of the two with Privacy right behind it. -->
            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="About" Tag="about"
                                         AutomationProperties.AutomationId="SettingsNavAbout">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Privacy" Tag="privacy"
                                         AutomationProperties.AutomationId="SettingsNavPrivacy">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <!-- The content-area plate, painted directly over NavigationView's own ContentGrid:
                 that grid's background is not exposed as a settable property, so covering it is
                 the only way to control the content area's tint. Both themes are flat, opaque
                 solid colors — in Dark this is deliberately a step lighter than the nav pane
                 beside it so the two read as separate surfaces, in Light it is the flat near-white
                 it has always been. Colors.xaml points NavigationViewContentBackground at the same
                 opaque brush so nothing shows through the edges of this Grid either. -->
            <Grid Padding="32,24,32,24" Background="{ThemeResource SwiftXCanvasBrush}">
                <!-- ==================== HOME (ring customization) ==================== -->
                <ScrollViewer x:Name="HomePanel">
                    <StackPanel Spacing="12" MaxWidth="920" HorizontalAlignment="Left">
                        <TextBlock Text="Home" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Click an empty slot or + to add; click an item to see its details; click a group to see what's inside; drag an item to rearrange. The corner button switches to what the hot corner opens, which is arranged the same way."
                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                        <!-- An adaptive Grid rather than two fixed-width blocks in a horizontal
                             StackPanel: a horizontal StackPanel never constrains its children to
                             the space actually available, so if the ring-preview card plus a fixed
                             336px sidebar plus the nav pane and content padding ever add up to more
                             than the window's client width — a near-miss under some font metrics/
                             DPI combinations — the sidebar simply got clipped at the window edge.
                             Auto for the ring-preview card (it has a fixed pixel footprint) and a
                             capped Star for the sidebar means the sidebar instead shrinks to
                             whatever room is actually left, so the row can never exceed the space
                             it's given. -->
                        <Grid ColumnSpacing="20" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MaxWidth="336" />
                            </Grid.ColumnDefinitions>

                            <!-- The two ring-wide actions sit on the canvas itself, in the space
                                 below the ring: they act on what is drawn there, and the ring's own
                                 footprint never reaches the bottom of the canvas (it is scaled to
                                 fit well inside), so nothing is covered. -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Background="{ThemeResource SwiftXRingCanvasBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8">
                                <Grid>
                                    <Canvas x:Name="PreviewCanvas" Width="360" Height="360" />
                                    <StackPanel x:Name="CanvasActions" Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                Margin="0,0,0,4">
                                        <Button x:Name="AddItemButton" Content="Add item…" Click="AddItem_Click" />
                                        <Button Content="Reset defaults" Click="ResetDefaults_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="12" MinWidth="0">
                                <Border Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8A3;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Size" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="ItemSizeBox" Grid.Column="2" MinWidth="0" Width="110"
                                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Item size"
                                                  SelectionChanged="ItemSizeBox_SelectionChanged">
                                            <ComboBoxItem Content="Small" Tag="Small" />
                                            <ComboBoxItem Content="Medium" Tag="Medium" />
                                            <ComboBoxItem Content="Large" Tag="Large" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE9E9;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Radius" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="RadiusSlider" Grid.Column="2" MinWidth="130" Width="130"
                                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                                AutomationProperties.Name="Ring radius"
                                                Minimum="80" Maximum="220" StepFrequency="5" TickFrequency="20"
                                                ValueChanged="RadiusSlider_ValueChanged" />
                                    </Grid>
                                </Border>

                                <!-- The pointer half of "Invoke", and a ring setting rather than an
                                     app-wide one, so it lives here beside size and radius. Two rows:
                                     the switch, then — as part of the same section rather than a
                                     card of its own — which corner and how much of the ring it
                                     opens. The second row means nothing while the corner is off, so
                                     it is collapsed rather than merely disabled — no dead controls
                                     left sitting in the card. Margin carries the gap between the two
                                     rows instead of Grid.RowSpacing, which pads a collapsed row's
                                     empty space too and would leave a bare gap when it disappears. -->
                                <Border Style="{StaticResource Card}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE740;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Hot corner"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="HotCornerEnabledToggle" Grid.Row="0" Grid.Column="2"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      AutomationProperties.Name="Hot corner"
                                                      VerticalAlignment="Center" HorizontalAlignment="Right"
                                                      AutomationProperties.AutomationId="SettingsHotCornerToggle"
                                                      Toggled="HotCornerEnabled_Toggled" />

                                        <StackPanel x:Name="HotCornerOptionsRow" Grid.Row="1" Grid.Column="0"
                                                    Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12"
                                                    Margin="0,10,0,0">
                                            <ComboBox x:Name="HotCornerBox" MinWidth="0" Width="112"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Hot corner position"
                                                      AutomationProperties.AutomationId="SettingsHotCornerBox"
                                                      SelectionChanged="HotCornerBox_SelectionChanged">
                                                <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                                <ComboBoxItem Content="Top right" Tag="TopRight" />
                                                <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                                                <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                                            </ComboBox>
                                            <RadioButton x:Name="HotCornerLayoutRing" Content="Ring"
                                                         GroupName="HotCornerLayout" MinWidth="0"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.AutomationId="SettingsHotCornerLayoutRing"
                                                         Checked="HotCornerLayout_Checked" />
                                            <RadioButton x:Name="HotCornerLayoutQuadrant" Content="Quadrant"
                                                         GroupName="HotCornerLayout" MinWidth="0"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.AutomationId="SettingsHotCornerLayoutQuadrant"
                                                         Checked="HotCornerLayout_Checked" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Read-only inspector for whatever item was last clicked, on the
                                     main ring or inside an expanded group's children row below.
                                     No edit/save controls here — real edits happen on the "Elements"
                                     tab. Hidden until something is selected. -->
                                <Border x:Name="InfoBox" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Name" Style="{StaticResource SecondaryCaption}" />
                                        <TextBlock x:Name="InfoName" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Target" Style="{StaticResource SecondaryCaption}" Margin="0,6,0,0" />
                                        <TextBlock x:Name="InfoTarget" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Revealed in place of a group bubble's own slot when it's clicked, instead
                             of replacing the whole ring view. Uses the ring-canvas grey (not the
                             white Card look) so it reads as the canvas extended, not another box. -->
                        <Border x:Name="GroupRow" Visibility="Collapsed" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource SwiftXRingCanvasBrush}"
                                BorderBrush="{ThemeResource SwiftXCardStrokeBrush}" Padding="16,14">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="GroupRowTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <Canvas x:Name="GroupChildrenCanvas" Height="52" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== GENERAL ==================== -->
                <ScrollViewer x:Name="GeneralPanel" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="General" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE771;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Theme" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Frosted dark glass (Dark), true black glass (Midnight), or solid white (Light). System follows Windows."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="Theme"
                                          SelectionChanged="ThemeBox_SelectionChanged">
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                    <!-- Displayed as "Midnight" — Tag stays "Black" to match the AppTheme.Black
                                         enum member, which JsonStringEnumConverter persists by name in ring.json;
                                         renaming the enum itself would strand every saved config that already
                                         has "Black" written into it. -->
                                    <ComboBoxItem Content="Midnight" Tag="Black" />
                                    <ComboBoxItem Content="System" Tag="System" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE962;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hover style" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Invert swaps an item's fill to the opposite color under the pointer. Zoom keeps its color and shrinks it slightly instead."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="HoverStyleBox" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="Hover style"
                                          SelectionChanged="HoverStyleBox_SelectionChanged">
                                    <ComboBoxItem Content="Invert" Tag="Invert" />
                                    <ComboBoxItem Content="Zoom" Tag="Zoom" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE765;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Invoke" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Show or hide the ring from the keyboard."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource SecondaryCaption}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <controls:HotkeyCaptureButton x:Name="HotkeyCapture"
                                                                  VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="HotkeyEnabledToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="Keyboard shortcut"
                                                  VerticalAlignment="Center"
                                                  Toggled="HotkeyEnabled_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7E8;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Start with Windows" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Launch SwiftX when you sign in."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              AutomationProperties.Name="Start with Windows"
                                              HorizontalAlignment="Right"
                                              Toggled="StartupToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8C8;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Backup &amp; restore" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Export or import your ring configuration as JSON."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Content="Export…" Click="Export_Click" />
                                    <Button Content="Import…" Click="Import_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE777;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Reset" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Restore default theme, hover style, item size, radius, hotkey, tools, and ring items."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Reset" VerticalAlignment="Center"
                                        Click="ResetAll_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== ELEMENTS ==================== -->
                <ScrollViewer x:Name="AppsPanel" Visibility="Collapsed"
                              AutomationProperties.AutomationId="SettingsAppsPanel">
                    <StackPanel Spacing="6">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Elements" Style="{ThemeResource TitleTextBlockStyle}" />
                            <Button Grid.Column="1" Content="Add item…" VerticalAlignment="Center" Click="AddAppItem_Click" />
                        </Grid>
                        <TextBlock Text="Elements are the apps, files, folders, links, and groups you've added to the ring. Show, hide, or remove items on the ring. Settings and Close are always on the ring, so they are not listed here."
                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid x:Name="ItemsList" ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== TOOLS ==================== -->
                <ScrollViewer x:Name="ToolsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Tools" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="Every tool lives inside the Tools item on the ring. Turn one off to take it out, or drag it by its handle to change where it sits inside."
                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" Margin="0,0,0,4" />

                        <!-- Rows are built in code-behind (RebuildToolsList) — six fixed built-in
                             tools, each shown once here regardless of how many ring instances they
                             have. CanReorderItems + AllowDrop is WinUI's own drag-to-reorder; it
                             drives ToolCards directly (see ToolCards_CollectionChanged). -->
                        <ListView x:Name="ToolsList" SelectionMode="None"
                                  CanReorderItems="True" AllowDrop="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== PRIVACY ==================== -->
                <!-- Its own page rather than a paragraph on About: this is the part of the app a
                     user may actually need to go and check, and it is written to say what happens
                     to their data, not where the bytes sit. -->
                <ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed"
                              AutomationProperties.AutomationId="SettingsPrivacyPanel">
                    <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Privacy" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="What SwiftX does — and does not do — with what you put into it."
                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE977;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Everything stays on this device"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Your ring items and settings are saved to this PC only. There is no SwiftX account and no server to sync to."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9D9;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="No tracking, no analytics"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="SwiftX collects no usage data, sends no crash or telemetry reports, and shows no ads."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE72E;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Secure values are encrypted for your account"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Anything kept in Secure values is protected by Windows' own per-user encryption, so it can only be read back while you are signed in to this account on this device."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE90F;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="The tools run offline"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Text you paste and files you open in the built-in tools are processed on this device and are never uploaded anywhere."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE774;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="The one thing that touches the network"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="A web link on the ring may ask that site for its icon so the item can show it. That request carries nothing about you, and it is the only network call SwiftX makes on its own."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE74D;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="You can take it all back"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Export your setup at any time from General, and Reset clears it back to defaults."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== ABOUT ==================== -->
                <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
                    <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="About" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="SwiftX" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryCaption}" />
                                <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                           Text="A quick-access ring for Windows. Summon it with a shortcut, a screen corner, or the tray icon, and launch the apps, folders, links, and built-in tools you reach for most." />
                                <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                           Text="SwiftX runs entirely on your own device — see Privacy for what that means." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
