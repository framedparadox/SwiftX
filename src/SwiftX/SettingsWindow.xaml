<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwiftX.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SwiftX.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="SwiftX Settings">

    <!-- WinUI Window has no Resources; shared styles live on the root Grid. -->
    <Grid x:Name="Root" Background="{ThemeResource SwiftXSurfaceBrush}">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SwiftXCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SwiftXCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <!-- ThemeResource inside a Style resolves against the element the style lands on,
                 so Light Settings never paints Dark secondary text into a white card. -->
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SwiftXMutedBrush}" />
            </Style>
            <Style x:Key="SecondaryCaption" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SwiftXMutedBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar is the shared Controls.AppTitleBar (same one ToolWindowBase uses), built in
             code-behind because its constructor takes glyph/title and XAML object elements need a
             parameterless constructor. -->

        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="Collapsed"
                             IsTitleBarAutoPaddingEnabled="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="home" IsSelected="True"
                                         AutomationProperties.AutomationId="SettingsNavHome">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="General" Tag="general"
                                         AutomationProperties.AutomationId="SettingsNavGeneral">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Shortcuts" Tag="shortcuts"
                                         AutomationProperties.AutomationId="SettingsNavShortcuts">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Apps &amp; links" Tag="apps"
                                         AutomationProperties.AutomationId="SettingsNavApps">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Tools" Tag="tools"
                                         AutomationProperties.AutomationId="SettingsNavTools">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="About" Tag="about"
                                         AutomationProperties.AutomationId="SettingsNavAbout">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid Padding="32,24,32,24">
                <!-- ==================== HOME (ring customization) ==================== -->
                <ScrollViewer x:Name="HomePanel">
                    <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Home" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Customize your ring. Click an empty slot or + to add; click an item to edit or remove; drag an item to rearrange."
                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" Padding="20">
                            <Canvas x:Name="PreviewCanvas" Width="360" Height="360" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Add item…" Click="AddItem_Click" />
                            <Button Content="Reset defaults" Click="ResetDefaults_Click" />
                        </StackPanel>
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed" Spacing="8">
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="EditTitle" FontWeight="SemiBold" />
                                    <TextBox x:Name="EditName" Header="Name" />
                                    <TextBox x:Name="EditTarget" Header="Target" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save" Style="{ThemeResource AccentButtonStyle}" Click="SaveEdit_Click" />
                                        <Button Content="Remove" Click="RemoveEdit_Click" />
                                        <Button Content="↑" Click="MoveUp_Click" ToolTipService.ToolTip="Move earlier on ring" />
                                        <Button Content="↓" Click="MoveDown_Click" ToolTipService.ToolTip="Move later on ring" />
                                        <Button Content="Open group…" x:Name="OpenGroupBtn" Click="OpenGroup_Click" Visibility="Collapsed" />
                                        <Button Content="Cancel" Click="CancelEdit_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== GENERAL ==================== -->
                <ScrollViewer x:Name="GeneralPanel" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="General" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE771;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Theme" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Solid black (Dark) or solid white (Light). System follows Windows."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          SelectionChanged="ThemeBox_SelectionChanged">
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                    <ComboBoxItem Content="System" Tag="System" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8A3;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ring item size" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="How large the items around the ring are drawn. The center logo stays a fixed size."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ItemSizeBox" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          SelectionChanged="ItemSizeBox_SelectionChanged">
                                    <ComboBoxItem Content="Small" Tag="Small" />
                                    <ComboBoxItem Content="Medium" Tag="Medium" />
                                    <ComboBoxItem Content="Large" Tag="Large" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9E9;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ring radius" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="How far the items sit from the center of the ring."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Slider x:Name="RadiusSlider" Grid.Column="2" MinWidth="170" Width="170"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Minimum="80" Maximum="220" StepFrequency="5" TickFrequency="20"
                                        ValueChanged="RadiusSlider_ValueChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7C4;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Floating launcher" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="An always-on-top button that opens the ring with the mouse. Drag it anywhere; drop it on a screen edge and it hides behind it, leaving a notch that brings it back when you hover."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button x:Name="LauncherResetButton" Content="Reset position"
                                            Click="LauncherReset_Click" />
                                    <ToggleSwitch x:Name="LauncherToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  Toggled="LauncherToggle_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7E8;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Start with Windows" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Launch SwiftX when you sign in."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              Toggled="StartupToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8C8;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Backup &amp; restore" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Export or import your ring configuration as JSON."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Content="Export…" Click="Export_Click" />
                                    <Button Content="Import…" Click="Import_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE777;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Reset" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Restore default theme, item size, radius, hotkey, tools, and ring items."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Reset" VerticalAlignment="Center"
                                        Click="ResetAll_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== SHORTCUTS ==================== -->
                <ScrollViewer x:Name="ShortcutsPanel" Visibility="Collapsed"
                              AutomationProperties.AutomationId="SettingsShortcutsPanel">
                    <StackPanel Spacing="6" VerticalAlignment="Top">
                        <TextBlock Text="Shortcuts" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE765;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Invoke" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Show or hide the ring from the keyboard."
                                               Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource SecondaryCaption}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <controls:HotkeyCaptureButton x:Name="HotkeyCapture"
                                                                  VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="HotkeyEnabledToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="HotkeyEnabled_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== APPS & LINKS ==================== -->
                <ScrollViewer x:Name="AppsPanel" Visibility="Collapsed"
                              AutomationProperties.AutomationId="SettingsAppsPanel">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Apps &amp; links" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="Show, hide, or remove apps, links, and folders on the ring. Built-in tools are managed on the Tools page. Settings and Close are always on the ring, so they are not listed here."
                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid x:Name="ItemsList" ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== TOOLS ==================== -->
                <ScrollViewer x:Name="ToolsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Tools" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="Show or hide built-in tools on the ring, or open one directly."
                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE943;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="JSON" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Show the JSON formatter as a ring item."
                                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OpenJson_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Open">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    </Button>
                                    <ToggleSwitch x:Name="JsonToggle" Grid.Column="3"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Toggled="ToolToggle_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8A5;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="XML" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Show the XML formatter as a ring item."
                                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OpenXml_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Open">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    </Button>
                                    <ToggleSwitch x:Name="XmlToggle" Grid.Column="3"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Toggled="ToolToggle_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE72E;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Secure values" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Show the local key/secret store as a ring item."
                                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OpenSecureValues_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Open">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    </Button>
                                    <ToggleSwitch x:Name="SecureValuesToggle" Grid.Column="3"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Toggled="ToolToggle_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xEB95;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Certificate" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Show the certificate inspector as a ring item."
                                                   Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OpenCertificate_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Open">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    </Button>
                                    <ToggleSwitch x:Name="CertificateToggle" Grid.Column="3"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Toggled="ToolToggle_Toggled" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== ABOUT ==================== -->
                <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
                    <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="About" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="SwiftX" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryCaption}" />
                                <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                           Text="SwiftX is a quick-access ring for Windows. It stays on your PC: settings live in %AppData%\SwiftX, and nothing is uploaded. Favicon fetches for web links are the only optional network use." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
