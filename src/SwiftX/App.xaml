<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SwiftX.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- ThemeDictionaries: a solid white Light, and a Dark built from solid, opaque
                     grey plates (nav pane, content canvas, cards, and the recessed "tray" areas
                     each a deliberately different shade) — no Mica/acrylic backdrop anywhere.
                     Prefer ThemeHelper.Brush or {ThemeResource} against a window root — not
                     Application.Current alone. -->
                <ResourceDictionary Source="Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
