<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light chrome is the original solid theme: #FFFFFF, no acrylic anywhere.
        Dark chrome is also solid — no backdrop of any kind — but built as deliberately different,
        opaque grey plates (nav pane, content canvas, cards, and the recessed "tray" areas) rather
        than flat black everywhere, so the surfaces stay visually distinct from one another without
        needing a translucent material to do it. An earlier iteration ran these same plates over a
        real DesktopAcrylicBackdrop with alpha-carrying fills; that backdrop was removed and every
        fill below converted back to a solid color, keeping the same layering/step-lighter design.
        Ring* keys are shared with RingWindow; the ring agent owns geometry/animation and should
        resolve these via ThemeHelper.Brush(Root, …) or {ThemeResource}, never Application.Current.
        RingWindow.xaml holds no resource references at all (it paints from ThemeHelper.ColorFor,
        a hard-coded C# switch), so nothing here can reach it.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SwiftXSurfaceColor">#000000</Color>
            <Color x:Key="SwiftXForegroundColor">#FFFFFF</Color>
            <Color x:Key="SwiftXBorderColor">#333333</Color>
            <Color x:Key="SwiftXMutedColor">#888888</Color>
            <Color x:Key="SwiftXAccentColor">#FFFFFF</Color>
            <Color x:Key="RingBubbleBackgroundColor">#000000</Color>
            <Color x:Key="RingHubBackgroundColor">#000000</Color>
            <Color x:Key="RingWindowBackgroundColor">#00000000</Color>

            <SolidColorBrush x:Key="SwiftXSurfaceBrush" Color="{StaticResource SwiftXSurfaceColor}"/>
            <SolidColorBrush x:Key="SwiftXForegroundBrush" Color="{StaticResource SwiftXForegroundColor}"/>
            <SolidColorBrush x:Key="SwiftXBorderBrush" Color="{StaticResource SwiftXBorderColor}"/>
            <SolidColorBrush x:Key="SwiftXMutedBrush" Color="{StaticResource SwiftXMutedColor}"/>
            <SolidColorBrush x:Key="SwiftXAccentBrush" Color="{StaticResource SwiftXAccentColor}"/>
            <SolidColorBrush x:Key="RingBubbleBackground" Color="{StaticResource RingBubbleBackgroundColor}"/>
            <SolidColorBrush x:Key="RingHubBackground" Color="{StaticResource RingHubBackgroundColor}"/>
            <SolidColorBrush x:Key="RingWindowBackground" Color="{StaticResource RingWindowBackgroundColor}"/>
            <!-- Settings-only root fill (SettingsWindow.xaml's Root Grid uses this, not
                 SwiftXSurfaceBrush): sample-data/design-colours.md's Surface.Base, #202020, the
                 canonical Win11 dark-app surface. SwiftXSurfaceBrush above stays #000000 because
                 AddItemWindow and the tool windows share that key and are out of scope here — see
                 the longer comment a few lines down by the other Settings-exclusive keys. -->
            <Color x:Key="SettingsSurfaceColor">#202020</Color>
            <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="{StaticResource SettingsSurfaceColor}"/>
            <!-- Dark Settings palette anchored on sample-data/design-colours.md's Windows colour
                 spec: Surface.Base (#202020) is the canonical Win11 dark-app surface — used here
                 for the content canvas, which is also what Root's own Background resolves to (see
                 SettingsWindow.xaml), so the sliver of Root that shows through around the title bar
                 and NavigationView's own chrome matches the content exactly instead of the pure
                 #000000 that used to show there. #000000 read as noticeably, jarringly darker than
                 the surrounding page — the literal "too dark" — because it is one specific
                 unthemed key (SwiftXSurfaceColor above) shared with AddItemWindow and the tool
                 windows, which must keep it: only the four keys below are Settings-exclusive (nothing
                 else in the app references them — verified), so only they move. Nav pane at #1C1C1C
                 is design-colours.md's own Surface.Tint value, one step recessed from the base
                 surface. Cards and the ring-canvas tray are not named in the spec (it only prescribes
                 a single flat surface plus system semantic tokens), so they keep this app's existing
                 raised/recessed layering, just re-centered around the new, lighter #202020 anchor
                 instead of the old #000000-adjacent one. -->
            <SolidColorBrush x:Key="SwiftXCardBackgroundBrush" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="SwiftXCardStrokeBrush" Color="#4A4A4A"/>
            <SolidColorBrush x:Key="SwiftXCanvasBrush" Color="#202020"/>
            <SolidColorBrush x:Key="SwiftXNavPaneBrush" Color="#1C1C1C"/>
            <!-- Overrides the framework's own key so NavigationView's pane (which reads this key
                 straight from its control template, not from an exposed CLR property) picks up
                 our plate instead of the WinUI default of in-app Acrylic. -->
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SwiftXNavPaneBrush"/>
            <!-- The content-area counterpart, pointed at the same opaque canvas color rather than
                 left Transparent: SettingsWindow paints its own SwiftXCanvasBrush Grid directly
                 over the entire NavigationView content region, so what shows through here barely
                 matters once both are opaque — this is just belt-and-suspenders so nothing shows
                 through at the Grid's own edges (e.g. during a resize) instead of the intended
                 canvas color. -->
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SwiftXCanvasBrush"/>
            <!-- SettingsWindow.xaml references this key unconditionally (not theme-gated), so it
                 must exist in every theme dictionary or {ThemeResource} throws XamlParseException
                 the moment this dictionary is the active one — it isn't just a Light-mode nicety.
                 The recessed layer: darker than every other plate, so the Home tab's ring-preview
                 canvas and its group-children strip read as a tray sunk into the page rather than
                 as another card raised off it. -->
            <SolidColorBrush x:Key="SwiftXRingCanvasBrush" Color="#1A1A1A"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SwiftXSurfaceColor">#FFFFFF</Color>
            <Color x:Key="SwiftXForegroundColor">#000000</Color>
            <Color x:Key="SwiftXBorderColor">#CCCCCC</Color>
            <Color x:Key="SwiftXMutedColor">#666666</Color>
            <Color x:Key="SwiftXAccentColor">#000000</Color>
            <Color x:Key="RingBubbleBackgroundColor">#FFFFFF</Color>
            <Color x:Key="RingHubBackgroundColor">#FFFFFF</Color>
            <Color x:Key="RingWindowBackgroundColor">#00000000</Color>

            <SolidColorBrush x:Key="SwiftXSurfaceBrush" Color="{StaticResource SwiftXSurfaceColor}"/>
            <SolidColorBrush x:Key="SwiftXForegroundBrush" Color="{StaticResource SwiftXForegroundColor}"/>
            <SolidColorBrush x:Key="SwiftXBorderBrush" Color="{StaticResource SwiftXBorderColor}"/>
            <SolidColorBrush x:Key="SwiftXMutedBrush" Color="{StaticResource SwiftXMutedColor}"/>
            <SolidColorBrush x:Key="SwiftXAccentBrush" Color="{StaticResource SwiftXAccentColor}"/>
            <SolidColorBrush x:Key="RingBubbleBackground" Color="{StaticResource RingBubbleBackgroundColor}"/>
            <SolidColorBrush x:Key="RingHubBackground" Color="{StaticResource RingHubBackgroundColor}"/>
            <SolidColorBrush x:Key="RingWindowBackground" Color="{StaticResource RingWindowBackgroundColor}"/>
            <!-- Settings-only root fill, same idea as the Dark dictionary's: sample-data/
                 design-colours.md's Light Surface.Base (#F3F3F3), not SwiftXSurfaceBrush's plain
                 #FFFFFF — AddItemWindow and the tool windows keep that key's original white
                 unchanged, since they share it and are out of scope here. Matches SwiftXCanvasBrush
                 below so Root's own background (visible around the title bar) agrees with the
                 content area instead of reading as a slightly different white. -->
            <Color x:Key="SettingsSurfaceColor">#F3F3F3</Color>
            <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="{StaticResource SettingsSurfaceColor}"/>
            <!-- 100% white: Light Settings has exactly two things that are allowed to read as
                 grey — the canvas (SwiftXCanvasBrush/SwiftXRingCanvasBrush below) and a
                 highlighted/selected nav item (SwiftXNavSelected* below). Every other surface,
                 including this card background, is pure white so those two stay visually
                 distinct instead of blending into a field of near-whites. -->
            <SolidColorBrush x:Key="SwiftXCardBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SwiftXCardStrokeBrush" Color="#CCCCCC"/>
            <!-- The NavigationView pane + content area ("section background") — sample-data/
                 design-colours.md's Light Surface.Base, #F3F3F3 exactly (this dictionary previously
                 nudged it to #FAFAFA, closer to white than the spec's own value; that nudge is gone
                 now that Settings is meant to track the spec directly). -->
            <SolidColorBrush x:Key="SwiftXCanvasBrush" Color="#F3F3F3"/>
            <!-- A shade more recessed than both the page background above and the generic Card
                 background below, dedicated to the Home tab's ring-preview canvas so it reads as
                 its own distinct "tray" rather than just another settings card. -->
            <SolidColorBrush x:Key="SwiftXRingCanvasBrush" Color="#EEEEEE"/>
            <!-- Strictly neutral (R=G=B) selected-nav-item greys. WinUI's own tokens here
                 (SubtleFillColorSecondary/TertiaryBrush, etc.) can be influenced by the user's
                 Windows accent-color personalization, which read as "a little bit pink" against a
                 light pane. Going fully explicit removes that whole class of doubt rather than
                 chasing which token was actually the source. -->
            <SolidColorBrush x:Key="SwiftXNavSelectedBrush" Color="#E8E8E8"/>
            <SolidColorBrush x:Key="SwiftXNavSelectedHoverBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="SwiftXNavSelectedPressedBrush" Color="#D8D8D8"/>
            <SolidColorBrush x:Key="SwiftXNavSelectedDisabledBrush" Color="#EDEDED"/>
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SwiftXCanvasBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SwiftXNavSelectedBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="SwiftXNavSelectedHoverBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="SwiftXNavSelectedPressedBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedDisabled" ResourceKey="SwiftXNavSelectedDisabledBrush"/>
            <!-- CardStrokeColorDefaultBrush (the WinUI default here) is itself neutral, but pinned
                 to our own already-neutral stroke brush anyway so this line is never a place a
                 future Fluent token change could reintroduce a tint. -->
            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SwiftXCardStrokeBrush"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="SwiftXSurfaceColor">#000000</Color>
            <Color x:Key="SwiftXForegroundColor">#FFFFFF</Color>
            <Color x:Key="SwiftXBorderColor">#333333</Color>
            <Color x:Key="SwiftXMutedColor">#888888</Color>
            <Color x:Key="SwiftXAccentColor">#FFFFFF</Color>
            <Color x:Key="RingBubbleBackgroundColor">#000000</Color>
            <Color x:Key="RingHubBackgroundColor">#000000</Color>
            <Color x:Key="RingWindowBackgroundColor">#00000000</Color>

            <SolidColorBrush x:Key="SwiftXSurfaceBrush" Color="{StaticResource SwiftXSurfaceColor}"/>
            <SolidColorBrush x:Key="SwiftXForegroundBrush" Color="{StaticResource SwiftXForegroundColor}"/>
            <SolidColorBrush x:Key="SwiftXBorderBrush" Color="{StaticResource SwiftXBorderColor}"/>
            <SolidColorBrush x:Key="SwiftXMutedBrush" Color="{StaticResource SwiftXMutedColor}"/>
            <SolidColorBrush x:Key="SwiftXAccentBrush" Color="{StaticResource SwiftXAccentColor}"/>
            <SolidColorBrush x:Key="RingBubbleBackground" Color="{StaticResource RingBubbleBackgroundColor}"/>
            <SolidColorBrush x:Key="RingHubBackground" Color="{StaticResource RingHubBackgroundColor}"/>
            <SolidColorBrush x:Key="RingWindowBackground" Color="{StaticResource RingWindowBackgroundColor}"/>
            <!-- See the matching comment in the Dark dictionary above. -->
            <Color x:Key="SettingsSurfaceColor">#202020</Color>
            <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="{StaticResource SettingsSurfaceColor}"/>
            <!-- Every fill below is the Dark dictionary's value verbatim. Default is what is live
                 in the brief window before ActualTheme resolves, so any drift between the two
                 would show up as a flash of a different palette as the window comes up. -->
            <SolidColorBrush x:Key="SwiftXCardBackgroundBrush" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="SwiftXCardStrokeBrush" Color="#4A4A4A"/>
            <SolidColorBrush x:Key="SwiftXCanvasBrush" Color="#202020"/>
            <!-- See the matching comment in the Dark dictionary above. -->
            <SolidColorBrush x:Key="SwiftXNavPaneBrush" Color="#1C1C1C"/>
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SwiftXNavPaneBrush"/>
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SwiftXCanvasBrush"/>
            <!-- See the matching comment in the Dark dictionary above — this key is referenced
                 unconditionally from SettingsWindow.xaml and must exist here too. -->
            <SolidColorBrush x:Key="SwiftXRingCanvasBrush" Color="#1A1A1A"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
