<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light chrome is fully opaque — no alpha anywhere, so nothing behind it is ever visible and
        MicaBackdrop, though still attached to the window, never shows through under Light. That is
        the only sense in which Light is "unchanged": its opacity. Its palette was since inverted
        (a pure-white canvas with cards a cool step *darker* at #F0F4F8, reading as recessed rather
        than raised) — see the Light dictionary's own card comment below, which is where that
        reversal is explained.
        Dark chrome sits on a real MicaBackdrop (ShellWindow's constructor) as of the Windows
        acrylic theme work: the nav pane, content canvas, cards, and the recessed "tray" areas keep
        their original raised/recessed layering, just as alpha-carrying (~0xD9) versions of the same
        opaque colors instead of fully solid, so Mica's own subtle wallpaper tint shows through each
        plate rather than replacing the layering. Only Dark changed — Light's brushes are still
        100% opaque, so Light stays pixel-identical to before; MicaBackdrop is attached to the window
        regardless of theme, it simply never shows through anything under Light. (An earlier,
        pre-Windows-acrylic-theme iteration tried a similar alpha-over-backdrop approach and was
        reverted with no reason on record — this pass re-does it deliberately, incrementally, with
        each plate re-checked for legibility rather than converted in one pass.)
        Orbit bubbles (OrbitWindow) get their own live per-bubble DesktopAcrylicBackdrop — see
        OrbitBubbleGlassTint below and OrbitWindow.xaml.cs's CreateBubble — independent of Settings'
        window-level Mica.
        Orbit* keys are shared with OrbitWindow; the orbit agent owns geometry/animation and should
        resolve these via ThemeHelper.Brush(Root, …) or {ThemeResource}, never Application.Current.
        OrbitWindow.xaml holds no resource references at all (it paints from ThemeHelper.ColorFor,
        a hard-coded C# switch — see ThemeHelper.ColorFor's own OrbitBubbleGlassTint case), so
        nothing here can reach it.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SwiftXSurfaceColor">#000000</Color>
            <Color x:Key="SwiftXForegroundColor">#FFFFFF</Color>
            <Color x:Key="SwiftXBorderColor">#333333</Color>
            <Color x:Key="SwiftXMutedColor">#888888</Color>
            <Color x:Key="SwiftXAccentColor">#FFFFFF</Color>
            <!-- A fixed "communication blue", deliberately NOT SwiftXAccentColor/AccentFillColorDefaultBrush:
                 Secure values' Copy button (SecureValuesPage.ApplyHoverColors) has to read as blue
                 regardless of what the user (or Windows personalization) has the accent colour set
                 to, the same way SystemFillColorCriticalBrush's red never tracks the accent either.
                 The lighter tint in Dark mirrors how the framework's own SystemFillColorCritical
                 goes lighter in Dark than Light (#FF99A4 vs #C42B1C) for the same on-black-vs-on-white
                 contrast reason. -->
            <Color x:Key="SwiftXCopyHoverColor">#60CDFF</Color>
            <Color x:Key="OrbitBubbleBackgroundColor">#000000</Color>
            <!-- The orbit bubbles' live-glass tint (OrbitWindow's CreateBubble/ApplyBubbleFill) —
                 sits over a real DesktopAcrylicBackdrop, so this only needs to carry SwiftX's own
                 dark/light identity; the backdrop's own recipe already handles blur-vs-legibility
                 contrast. OrbitBubbleBackgroundColor above stays opaque black/white — it's still
                 used by hover-invert/close states and by Settings' own (non-glass) orbit preview. -->
            <Color x:Key="OrbitBubbleGlassTintColor">#66000000</Color>
            <Color x:Key="OrbitHubBackgroundColor">#000000</Color>
            <Color x:Key="OrbitWindowBackgroundColor">#00000000</Color>

            <SolidColorBrush x:Key="SwiftXSurfaceBrush" Color="{StaticResource SwiftXSurfaceColor}"/>
            <SolidColorBrush x:Key="SwiftXForegroundBrush" Color="{StaticResource SwiftXForegroundColor}"/>
            <SolidColorBrush x:Key="SwiftXBorderBrush" Color="{StaticResource SwiftXBorderColor}"/>
            <SolidColorBrush x:Key="SwiftXMutedBrush" Color="{StaticResource SwiftXMutedColor}"/>
            <SolidColorBrush x:Key="SwiftXAccentBrush" Color="{StaticResource SwiftXAccentColor}"/>
            <SolidColorBrush x:Key="SwiftXCopyHoverBrush" Color="{StaticResource SwiftXCopyHoverColor}"/>
            <SolidColorBrush x:Key="OrbitBubbleBackground" Color="{StaticResource OrbitBubbleBackgroundColor}"/>
            <SolidColorBrush x:Key="OrbitBubbleGlassTint" Color="{StaticResource OrbitBubbleGlassTintColor}"/>
            <SolidColorBrush x:Key="OrbitHubBackground" Color="{StaticResource OrbitHubBackgroundColor}"/>
            <SolidColorBrush x:Key="OrbitWindowBackground" Color="{StaticResource OrbitWindowBackgroundColor}"/>
            <!-- The add/replace dialog's root fill (AddItemWindow.xaml's Root Grid). Dark's own
                 surface, #222222, rather than the shared SwiftXSurfaceBrush above, whose #000000 is
                 Midnight's colour and made the dialog show Midnight's chrome whenever Dark was
                 selected. Fully opaque, unlike SettingsSurfaceBrush below: this window carries no
                 backdrop for an alpha to reveal. Midnight is not a XAML theme (see ThemeHelper.Resolve),
                 so AddItemWindow shadows this key with a flat black of its own when Midnight is
                 selected — see AddItemWindow.ApplyBlackOverrides. -->
            <SolidColorBrush x:Key="SwiftXDialogSurfaceBrush" Color="#222222"/>
            <!-- Settings-only root fill (ShellWindow.xaml's Root Grid uses this, not
                 SwiftXSurfaceBrush): dark canvas background, whose range is #1A1A1A to #222222 —
                 #222222, its light end, so the nav pane below can take #1A1A1A and still read as a
                 distinct, recessed surface beside it. SwiftXSurfaceBrush above stays #000000 because
                 the tool windows share that key and are out of scope here (AddItemWindow has since
                 moved to SwiftXDialogSurfaceBrush above, for the same reason Settings moved). -->
            <Color x:Key="SettingsSurfaceColor">#222222</Color>
            <!-- Alpha-carrying so ShellWindow's MicaBackdrop (see the constructor) shows through
                 — 0xD9 (~85%) keeps Mica's own wallpaper-derived tint to a subtle hint rather than a
                 strong blur, matching how understated Mica reads everywhere else in Windows. The four
                 plates' own distinct hues (below) still carry the raised/recessed hierarchy.
                 Dark only — Light's brushes below stay 100% opaque; Mica is still attached to the
                 window in Light too, it just never shows through anything. -->
            <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#D9222222"/>
            <!-- Dark Settings palette: canvas background #1A1A1A-#222222, card and container
                 background #2C2C2C. The canvas takes #222222 — the same value Root's own Background
                 resolves to (see ShellWindow.xaml), so the sliver of Root that shows through around
                 the title bar and NavigationView's own chrome matches the content exactly rather than
                 reading as a second, darker surface. The nav pane takes #1A1A1A, the other end of the
                 range, so pane and content read as two distinct surfaces. Cards remain at #2C2C2C.
                 Only the Settings-exclusive keys change: SwiftXSurfaceColor/Foreground/Border/Muted
                 above are shared with AddItemWindow (now by way of its own SwiftXDialogSurfaceBrush,
                 anchored to this same #222222), the tool windows, and the orbit (which also hardcodes
                 them a second time in ThemeHelper.ColorFor), and must stay as they are. -->
            <SolidColorBrush x:Key="SwiftXCardBackgroundBrush" Color="#D92C2C2C"/>
            <SolidColorBrush x:Key="SwiftXCardStrokeBrush" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="SwiftXCanvasBrush" Color="#D9222222"/>
            <SolidColorBrush x:Key="SwiftXNavPaneBrush" Color="#D91A1A1A"/>
            <!-- Overrides the framework's own key so NavigationView's pane (which reads this key
                 straight from its control template, not from an exposed CLR property) picks up
                 our plate instead of the WinUI default of in-app Acrylic. -->
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SwiftXNavPaneBrush"/>
            <!-- The one the Left-mode pane actually reads. NavigationViewDefaultPaneBackground
                 above governs other display modes; on its own it left the pane painting the
                 canvas colour (verified on screen in both themes), which stayed invisible only
                 while pane and canvas were near-identical greys. -->
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SwiftXNavPaneBrush"/>
            <!-- The content-area counterpart, pointed at the same opaque canvas color rather than
                 left Transparent: ShellWindow paints its own SwiftXCanvasBrush Grid directly
                 over the entire NavigationView content region, so what shows through here barely
                 matters once both are opaque — this is just belt-and-suspenders so nothing shows
                 through at the Grid's own edges (e.g. during a resize) instead of the intended
                 canvas color. -->
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SwiftXCanvasBrush"/>
            <!-- ShellWindow.xaml references this key unconditionally (not theme-gated), so it
                 must exist in every theme dictionary or {ThemeResource} throws XamlParseException
                 the moment this dictionary is the active one — it isn't just a Light-mode nicety.
                 The recessed layer: darker than the canvas and the cards it sits among, so the Home
                 tab's orbit-preview canvas and its group-children strip read as a tray sunk into the
                 page rather than as another card raised off it. The nav pane remains the darkest plate,
                 but the two are never adjacent, so what matters is that this stays a step below the
                 #222222 canvas it is actually sunk into. -->
            <SolidColorBrush x:Key="SwiftXOrbitCanvasBrush" Color="#D9202020"/>

            <!-- Text and accent, Settings-only. Deliberately NOT the shared SwiftXMutedBrush/
                 SwiftXAccentBrush above: those are read by the orbit, AddItemWindow, and the tool
                 windows, and SwiftXAccentBrush in particular is plain #FFFFFF there. Secondary Label
                 Text is a cool neutral grey; the accent is a bright teal and is the first
                 non-monochrome color the app has ever painted — see the Feedback & Support page's
                 links in ShellWindow.xaml, its only consumer today. -->
            <SolidColorBrush x:Key="SettingsSecondaryTextBrush" Color="#AAAAAA"/>
            <SolidColorBrush x:Key="SettingsAccentBrush" Color="#8A67FF"/>
            <SolidColorBrush x:Key="SettingsAccentHoverBrush" Color="#9F82FF"/>
            <!-- HyperlinkButton drives its colour from these four framework keys in every visual
                 state, so a Foreground set on the control (or in a Style) is honoured at rest and
                 then discarded on hover. Overriding them is the only way to hold the accent through
                 pointer-over and pressed.
                 They live here, inside the theme dictionaries, rather than in ShellWindow's own
                 Root.Resources: a StaticResource alias in a plain, non-theme-keyed dictionary
                 resolves once at parse time and then never re-resolves, so a Root-level override
                 would freeze whichever theme happened to be live when the window was built and stop
                 tracking theme switches. Inside a ThemeDictionary each theme aliases its own value,
                 which is exactly how the NavigationView* overrides above already work.
                 App-level in form, Settings-only in effect: the Feedback & Support page holds the
                 only HyperlinkButtons in the app. -->
            <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="SettingsAccentHoverBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="SettingsAccentHoverBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundDisabled" ResourceKey="SettingsSecondaryTextBrush"/>

            <!-- ==================== Shell (SwiftX app) — Logi's own palette ====================
                 Ported verbatim in hue from windows-app-mx's LogiApp/Themes/AppThemeResources.xaml
                 (branch logiApp/dotnet), which is what the SwiftX app shell is built to look like:
                 AppBackgroundBrush #2B2B2B, SettingsCardBackgroundBrush #333333,
                 SettingsCardBorderBrush #444444. The one adaptation is opacity — Logi paints these
                 flat, SwiftX's Dark chrome sits on a real MicaBackdrop and every other plate in this
                 dictionary carries the same ~0xD9 alpha so Mica's wallpaper tint reads through. A
                 flat shell here would be the one patch in the window that Mica could not reach, so
                 Logi's colours are carried at SwiftX's alpha rather than at Logi's full opacity.
                 Borders, dividers and text stay fully opaque, exactly as Logi has them. -->
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#D92B2B2B"/>
            <SolidColorBrush x:Key="ShellCardBackgroundBrush" Color="#D9333333"/>
            <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#444444"/>
            <!-- The ⌀88 icon medallion on a Home nav box and the ⌀44 one on a tool card: a step
                 below the card it sits on, so the glyph reads as inset into the card rather than
                 floating on it. -->
            <SolidColorBrush x:Key="ShellMedallionBrush" Color="#D9242424"/>
            <!-- The meta pill under a nav box's description ("8 slots · 6 user"). -->
            <SolidColorBrush x:Key="ShellPillBrush" Color="#D93A3A3A"/>
            <SolidColorBrush x:Key="ShellDividerBrush" Color="#444444"/>
            <SolidColorBrush x:Key="ShellToolbarIconBrush" Color="#BBBBBB"/>
            <SolidColorBrush x:Key="ShellSeparatorBrush" Color="#505050"/>

            <!-- Orbit Settings plates align with ShellBackgroundBrush / ShellCardBackgroundBrush
                 so Dark Orbit matches the rest of the app shell. Ring accent, nodes, hub and
                 pills stay on their own palette (Logi's teal canvas family). -->
            <SolidColorBrush x:Key="OrbitCanvasBackgroundBrush" Color="#D92B2B2B"/>
            <SolidColorBrush x:Key="OrbitCanvasBorderBrush" Color="#333333"/>
            <SolidColorBrush x:Key="OrbitNodeBackgroundBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="OrbitHubBrush" Color="#282828"/>
            <SolidColorBrush x:Key="OrbitLabelPillBrush" Color="#181818"/>
            <SolidColorBrush x:Key="OrbitLabelPillBorderBrush" Color="#2E2E2E"/>
            <SolidColorBrush x:Key="OrbitSidebarBackgroundBrush" Color="#D9333333"/>
            <SolidColorBrush x:Key="OrbitSidebarBorderBrush" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="OrbitCanvasAccentBrush" Color="#00DDB3"/>

            <!-- ==================== Logi Settings type/nav tokens ====================
                 The Settings screen's own text ramp and 4px rail, keyed exactly as Logi keys them
                 so the two files read against each other. The three accent-derived ones are
                 StaticResource aliases here (resolved once, per theme dictionary, the way the
                 HyperlinkButton* keys above already are) AND are re-shadowed from
                 ShellWindow.ApplyAccentColorOverride — without that second half a user's custom
                 accent would reach the links and toggles but not the rail or the theme cards. -->
            <SolidColorBrush x:Key="SettingsHeaderBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SettingsTitleBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SettingsMutedBrush" Color="#808080"/>
            <SolidColorBrush x:Key="SettingsNavInactiveBrush" Color="#A0A0A0"/>
            <StaticResource x:Key="SettingsNavActiveBrush" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="SettingsNavIndicatorBrush" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="SettingsCardSelectedBorderBrush" ResourceKey="SettingsAccentBrush"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SwiftXSurfaceColor">#FFFFFF</Color>
            <Color x:Key="SwiftXForegroundColor">#000000</Color>
            <Color x:Key="SwiftXBorderColor">#CCCCCC</Color>
            <Color x:Key="SwiftXMutedColor">#666666</Color>
            <Color x:Key="SwiftXAccentColor">#000000</Color>
            <!-- See the matching comment in the Dark dictionary above — the darker end of the same
                 communication-blue pair, for contrast on Light's white surfaces. -->
            <Color x:Key="SwiftXCopyHoverColor">#0078D4</Color>
            <Color x:Key="OrbitBubbleBackgroundColor">#FFFFFF</Color>
            <!-- See the matching comment in the Dark dictionary above. -->
            <Color x:Key="OrbitBubbleGlassTintColor">#66FFFFFF</Color>
            <Color x:Key="OrbitHubBackgroundColor">#FFFFFF</Color>
            <Color x:Key="OrbitWindowBackgroundColor">#00000000</Color>

            <SolidColorBrush x:Key="SwiftXSurfaceBrush" Color="{StaticResource SwiftXSurfaceColor}"/>
            <SolidColorBrush x:Key="SwiftXForegroundBrush" Color="{StaticResource SwiftXForegroundColor}"/>
            <SolidColorBrush x:Key="SwiftXBorderBrush" Color="{StaticResource SwiftXBorderColor}"/>
            <SolidColorBrush x:Key="SwiftXMutedBrush" Color="{StaticResource SwiftXMutedColor}"/>
            <SolidColorBrush x:Key="SwiftXAccentBrush" Color="{StaticResource SwiftXAccentColor}"/>
            <SolidColorBrush x:Key="SwiftXCopyHoverBrush" Color="{StaticResource SwiftXCopyHoverColor}"/>
            <SolidColorBrush x:Key="OrbitBubbleBackground" Color="{StaticResource OrbitBubbleBackgroundColor}"/>
            <SolidColorBrush x:Key="OrbitBubbleGlassTint" Color="{StaticResource OrbitBubbleGlassTintColor}"/>
            <SolidColorBrush x:Key="OrbitHubBackground" Color="{StaticResource OrbitHubBackgroundColor}"/>
            <SolidColorBrush x:Key="OrbitWindowBackground" Color="{StaticResource OrbitWindowBackgroundColor}"/>
            <!-- See the matching comment in the Dark dictionary above. Light's dialog surface is
                 the plain white it has always been — the shared SwiftXSurfaceBrush was already
                 right under Light, only Dark was showing the wrong theme — but it gets the same
                 dedicated key anyway, so AddItemWindow never again depends on a shared brush
                 happening to match by coincidence. -->
            <SolidColorBrush x:Key="SwiftXDialogSurfaceBrush" Color="#FFFFFF"/>
            <!-- Settings-only root fill, same idea as the Dark dictionary's: a pure-white canvas
                 with a soft, cold off-white at the edges. This is the pure-white end. It is also the
                 inversion of what Light Settings used to be — see the card comment below, which is
                 where that change actually shows. Matches SwiftXCanvasBrush so Root's own background
                 (visible around the title bar) agrees with the content area exactly. -->
            <Color x:Key="SettingsSurfaceColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="{StaticResource SettingsSurfaceColor}"/>
            <!-- A cool light card background, #F0F4F8. This inverts the relationship Light Settings
                 had before: it used to be a #F3F3F3 canvas with cards a step *lighter* at pure
                 #FFFFFF, so cards read as raised white panels on grey. The new light mode is the
                 other way round — a pure white canvas with cards a cool tint *darker*, so they read
                 as recessed panels inset into the page. That reversal is the single biggest visual
                 change in this palette and it is intentional; the stroke below is retinted to match
                 (a cool #DDE4EC rather than the old neutral #CCCCCC) so the card edge belongs to the
                 same cool family as its fill instead of cutting a grey line across it. -->
            <SolidColorBrush x:Key="SwiftXCardBackgroundBrush" Color="#F0F4F8"/>
            <SolidColorBrush x:Key="SwiftXCardStrokeBrush" Color="#DDE4EC"/>
            <!-- The NavigationView content area — pure white, per the canvas comment above. The
                 pane no longer shares this brush: it has its own SwiftXNavPaneBrush below, which
                 Light previously did not define at all. -->
            <SolidColorBrush x:Key="SwiftXCanvasBrush" Color="#FFFFFF"/>
            <!-- New in Light (Dark and Default have always had this key). The light mode gives
                 the control pane the same cool matte tone as its cards, one step off the white
                 canvas beside it, so the pane reads as its own surface rather than as more canvas.
                 With the canvas now pure white there is nothing left for the pane to differ from
                 unless it gets a value of its own — which is why pointing
                 NavigationViewDefaultPaneBackground at SwiftXCanvasBrush (what Light used to do)
                 would now leave the pane and content indistinguishable. -->
            <SolidColorBrush x:Key="SwiftXNavPaneBrush" Color="#F0F4F8"/>
            <!-- A shade more recessed than both the canvas and the cards, dedicated to the Home
                 tab's orbit-preview canvas so it reads as its own distinct "tray" rather than just
                 another settings card. Retinted cool along with the cards. -->
            <SolidColorBrush x:Key="SwiftXOrbitCanvasBrush" Color="#E7EDF3"/>
            <!-- Selected-nav-item fills, deliberately explicit rather than WinUI's own tokens here
                 (SubtleFillColorSecondary/TertiaryBrush, etc.), which can be influenced by the
                 user's Windows accent-color personalization and read as "a little bit pink" against
                 a light pane. These used to be strictly neutral (R=G=B) for exactly that reason;
                 they now carry the same deliberate cool tint as the pane they sit on, which is a
                 chosen hue rather than an inherited one, so the personalization problem stays
                 solved. Each is a step down from the #F0F4F8 pane. -->
            <SolidColorBrush x:Key="SwiftXNavSelectedBrush" Color="#DCE5EE"/>
            <SolidColorBrush x:Key="SwiftXNavSelectedHoverBrush" Color="#D2DDE8"/>
            <SolidColorBrush x:Key="SwiftXNavSelectedPressedBrush" Color="#C8D5E2"/>
            <SolidColorBrush x:Key="SwiftXNavSelectedDisabledBrush" Color="#E9EEF3"/>
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SwiftXNavPaneBrush"/>
            <!-- The one the Left-mode pane actually reads. NavigationViewDefaultPaneBackground
                 above governs other display modes; on its own it left the pane painting the
                 canvas colour (verified on screen in both themes), which stayed invisible only
                 while pane and canvas were near-identical greys. -->
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SwiftXNavPaneBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SwiftXNavSelectedBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="SwiftXNavSelectedHoverBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="SwiftXNavSelectedPressedBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedDisabled" ResourceKey="SwiftXNavSelectedDisabledBrush"/>
            <!-- Pinned to our own stroke brush so this line is never a place a future Fluent token
                 change could reintroduce a tint we did not choose. -->
            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SwiftXCardStrokeBrush"/>
            <!-- The content-area counterpart of the pane key above, same belt-and-suspenders reason
                 as Dark's: ShellWindow paints its own SwiftXCanvasBrush Grid over the whole
                 content region, so this only governs the Grid's own edges (e.g. mid-resize). Newly
                 needed in Light — the canvas is pure white now, so WinUI's default grey showing
                 through there would read as a visible seam rather than blending in the way it did
                 against the old #F3F3F3. -->
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SwiftXCanvasBrush"/>

            <!-- See the matching comment in the Dark dictionary above. Secondary Label Text is a
                 cool slate grey #555555 (the shared SwiftXMutedBrush stays #666666). The accent is a
                 deepened teal rather than the bright one Dark uses: as link text on a white card the
                 bright teal lands near 1.8:1, well under WCAG AA, while #0B7C7C holds the same hue
                 at ~5:1. -->
            <SolidColorBrush x:Key="SettingsSecondaryTextBrush" Color="#555555"/>
            <SolidColorBrush x:Key="SettingsAccentBrush" Color="#6C47FF"/>
            <SolidColorBrush x:Key="SettingsAccentHoverBrush" Color="#8668FF"/>
            <!-- See the matching comment in the Dark dictionary above. -->
            <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="SettingsAccentHoverBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="SettingsAccentHoverBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundDisabled" ResourceKey="SettingsSecondaryTextBrush"/>

            <!-- See the matching comment in the Dark dictionary above. Light is Logi's own Light
                 dictionary verbatim and fully opaque — #F2F2F2 page, #FFFFFF cards, #E0E0E0 edges
                 — because Light carries no alpha anywhere in this file and Mica never shows through
                 it. -->
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F2F2F2"/>
            <SolidColorBrush x:Key="ShellCardBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="ShellMedallionBrush" Color="#F4F6F9"/>
            <SolidColorBrush x:Key="ShellPillBrush" Color="#EDEFF2"/>
            <SolidColorBrush x:Key="ShellDividerBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="ShellToolbarIconBrush" Color="#555555"/>
            <SolidColorBrush x:Key="ShellSeparatorBrush" Color="#CCCCCC"/>

            <!-- The Orbit screen's own canvas palette. Deliberately a different family from the
                 Shell* tokens above: docs/full-app-mockups-logi-base.md records that Logi runs two
                 accents of its own — app chrome violet, ring canvas teal — and keeps the ring's
                 surfaces darker than the app's. The Orbit screen is built to that split (see
                 docs/images/17-app-ring.svg, which is where every value here comes from), so the
                 canvas reads as its own place rather than another page of Settings. -->
            <SolidColorBrush x:Key="OrbitCanvasBackgroundBrush" Color="#F7F9FB"/>
            <SolidColorBrush x:Key="OrbitCanvasBorderBrush" Color="#D8DEE6"/>
            <SolidColorBrush x:Key="OrbitNodeBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="OrbitHubBrush" Color="#E4E9EF"/>
            <SolidColorBrush x:Key="OrbitLabelPillBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="OrbitLabelPillBorderBrush" Color="#DDE4EC"/>
            <SolidColorBrush x:Key="OrbitSidebarBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="OrbitSidebarBorderBrush" Color="#E4E9EF"/>
            <!-- The canvas teal, darkened for contrast against a light ground: #00DDB3 on white
                 falls well under 3:1, which is where a 2px ring on a node stops being visible. -->
            <SolidColorBrush x:Key="OrbitCanvasAccentBrush" Color="#00A88A"/>

            <!-- See the matching comment in the Dark dictionary above. -->
            <SolidColorBrush x:Key="SettingsHeaderBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="SettingsTitleBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="SettingsMutedBrush" Color="#777777"/>
            <SolidColorBrush x:Key="SettingsNavInactiveBrush" Color="#444444"/>
            <StaticResource x:Key="SettingsNavActiveBrush" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="SettingsNavIndicatorBrush" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="SettingsCardSelectedBorderBrush" ResourceKey="SettingsAccentBrush"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="SwiftXSurfaceColor">#000000</Color>
            <Color x:Key="SwiftXForegroundColor">#FFFFFF</Color>
            <Color x:Key="SwiftXBorderColor">#333333</Color>
            <Color x:Key="SwiftXMutedColor">#888888</Color>
            <Color x:Key="SwiftXAccentColor">#FFFFFF</Color>
            <!-- See the matching comment in the Dark dictionary above. -->
            <Color x:Key="SwiftXCopyHoverColor">#60CDFF</Color>
            <Color x:Key="OrbitBubbleBackgroundColor">#000000</Color>
            <!-- The orbit bubbles' live-glass tint (OrbitWindow's CreateBubble/ApplyBubbleFill) —
                 sits over a real DesktopAcrylicBackdrop, so this only needs to carry SwiftX's own
                 dark/light identity; the backdrop's own recipe already handles blur-vs-legibility
                 contrast. OrbitBubbleBackgroundColor above stays opaque black/white — it's still
                 used by hover-invert/close states and by Settings' own (non-glass) orbit preview. -->
            <Color x:Key="OrbitBubbleGlassTintColor">#66000000</Color>
            <Color x:Key="OrbitHubBackgroundColor">#000000</Color>
            <Color x:Key="OrbitWindowBackgroundColor">#00000000</Color>

            <SolidColorBrush x:Key="SwiftXSurfaceBrush" Color="{StaticResource SwiftXSurfaceColor}"/>
            <SolidColorBrush x:Key="SwiftXForegroundBrush" Color="{StaticResource SwiftXForegroundColor}"/>
            <SolidColorBrush x:Key="SwiftXBorderBrush" Color="{StaticResource SwiftXBorderColor}"/>
            <SolidColorBrush x:Key="SwiftXMutedBrush" Color="{StaticResource SwiftXMutedColor}"/>
            <SolidColorBrush x:Key="SwiftXAccentBrush" Color="{StaticResource SwiftXAccentColor}"/>
            <SolidColorBrush x:Key="SwiftXCopyHoverBrush" Color="{StaticResource SwiftXCopyHoverColor}"/>
            <SolidColorBrush x:Key="OrbitBubbleBackground" Color="{StaticResource OrbitBubbleBackgroundColor}"/>
            <SolidColorBrush x:Key="OrbitBubbleGlassTint" Color="{StaticResource OrbitBubbleGlassTintColor}"/>
            <SolidColorBrush x:Key="OrbitHubBackground" Color="{StaticResource OrbitHubBackgroundColor}"/>
            <SolidColorBrush x:Key="OrbitWindowBackground" Color="{StaticResource OrbitWindowBackgroundColor}"/>
            <!-- See the matching comment in the Dark dictionary above — Default carries Dark's
                 value verbatim, so the dialog can't flash a different surface before ActualTheme
                 resolves. -->
            <SolidColorBrush x:Key="SwiftXDialogSurfaceBrush" Color="#222222"/>
            <!-- See the matching comment in the Dark dictionary above. -->
            <Color x:Key="SettingsSurfaceColor">#222222</Color>
            <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#D9222222"/>
            <!-- Every fill below is the Dark dictionary's value verbatim (alpha-carrying, same as
                 Dark, for the same MicaBackdrop reason) — Default is what is live in the brief
                 window before ActualTheme resolves, so any drift between the two would show up as a
                 flash of a different palette as the window comes up. That includes the text and
                 accent brushes at the end: they are Settings-only additions, and a Default that
                 omitted them would throw XamlParseException on any {ThemeResource} that reaches
                 them during that window. -->
            <SolidColorBrush x:Key="SwiftXCardBackgroundBrush" Color="#D92C2C2C"/>
            <SolidColorBrush x:Key="SwiftXCardStrokeBrush" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="SwiftXCanvasBrush" Color="#D9222222"/>
            <!-- See the matching comment in the Dark dictionary above. -->
            <SolidColorBrush x:Key="SwiftXNavPaneBrush" Color="#D91A1A1A"/>
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SwiftXNavPaneBrush"/>
            <!-- The one the Left-mode pane actually reads. NavigationViewDefaultPaneBackground
                 above governs other display modes; on its own it left the pane painting the
                 canvas colour (verified on screen in both themes), which stayed invisible only
                 while pane and canvas were near-identical greys. -->
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SwiftXNavPaneBrush"/>
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SwiftXCanvasBrush"/>
            <!-- See the matching comment in the Dark dictionary above — this key is referenced
                 unconditionally from ShellWindow.xaml and must exist here too. -->
            <SolidColorBrush x:Key="SwiftXOrbitCanvasBrush" Color="#D9202020"/>
            <SolidColorBrush x:Key="SettingsSecondaryTextBrush" Color="#AAAAAA"/>
            <SolidColorBrush x:Key="SettingsAccentBrush" Color="#8A67FF"/>
            <SolidColorBrush x:Key="SettingsAccentHoverBrush" Color="#9F82FF"/>
            <!-- See the matching comment in the Dark dictionary above. -->
            <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="SettingsAccentHoverBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="SettingsAccentHoverBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundDisabled" ResourceKey="SettingsSecondaryTextBrush"/>

            <!-- Dark's values verbatim, for the same reason every other fill in this dictionary
                 carries them: Default is what is live in the brief window before ActualTheme
                 resolves, and a {ThemeResource} that reaches a key missing here throws
                 XamlParseException rather than falling back. -->
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#D92B2B2B"/>
            <SolidColorBrush x:Key="ShellCardBackgroundBrush" Color="#D9333333"/>
            <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#444444"/>
            <SolidColorBrush x:Key="ShellMedallionBrush" Color="#D9242424"/>
            <SolidColorBrush x:Key="ShellPillBrush" Color="#D93A3A3A"/>
            <SolidColorBrush x:Key="ShellDividerBrush" Color="#444444"/>
            <SolidColorBrush x:Key="ShellToolbarIconBrush" Color="#BBBBBB"/>
            <SolidColorBrush x:Key="ShellSeparatorBrush" Color="#505050"/>

            <!-- Orbit Settings plates align with ShellBackgroundBrush / ShellCardBackgroundBrush
                 so Dark Orbit matches the rest of the app shell. Ring accent, nodes, hub and
                 pills stay on their own palette (Logi's teal canvas family). -->
            <SolidColorBrush x:Key="OrbitCanvasBackgroundBrush" Color="#D92B2B2B"/>
            <SolidColorBrush x:Key="OrbitCanvasBorderBrush" Color="#333333"/>
            <SolidColorBrush x:Key="OrbitNodeBackgroundBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="OrbitHubBrush" Color="#282828"/>
            <SolidColorBrush x:Key="OrbitLabelPillBrush" Color="#181818"/>
            <SolidColorBrush x:Key="OrbitLabelPillBorderBrush" Color="#2E2E2E"/>
            <SolidColorBrush x:Key="OrbitSidebarBackgroundBrush" Color="#D9333333"/>
            <SolidColorBrush x:Key="OrbitSidebarBorderBrush" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="OrbitCanvasAccentBrush" Color="#00DDB3"/>

            <SolidColorBrush x:Key="SettingsHeaderBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SettingsTitleBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SettingsMutedBrush" Color="#808080"/>
            <SolidColorBrush x:Key="SettingsNavInactiveBrush" Color="#A0A0A0"/>
            <StaticResource x:Key="SettingsNavActiveBrush" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="SettingsNavIndicatorBrush" ResourceKey="SettingsAccentBrush"/>
            <StaticResource x:Key="SettingsCardSelectedBorderBrush" ResourceKey="SettingsAccentBrush"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
