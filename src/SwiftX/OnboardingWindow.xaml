<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwiftX.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SwiftX.Controls"
    Title="Set up SwiftX">

    <!-- The first-run guide: pick what goes on the orbit, then pick the keys that summon it.
         Same Shell* palette and type ramp as ShellWindow (Themes/Colors.xaml, ported from
         windows-app-mx's LogiApp) so the first thing a new user sees is the app they are about to
         use, not a separate installer-looking dialog.

         Three steps in one window rather than three windows, switched by Visibility — the same
         idiom ShellWindow's own screen router uses. A wizard that spawns windows loses the user's
         place the moment they alt-tab away. -->
    <Grid x:Name="Root" Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ShellCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ShellCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="SettingTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsTitleBrush}" />
            </Style>
            <Style x:Key="SettingBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsSecondaryTextBrush}" />
            </Style>
            <Style x:Key="EditorialTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI, Cambria, Georgia" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="LineHeight" Value="34" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsHeaderBrush}" />
            </Style>
            <!-- Logi's nav-label treatment, reused for the step counter: 11px Bold caps at
                 CharacterSpacing 100. -->
            <Style x:Key="StepLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsAccentBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0 is Controls.AppTitleBar, inserted from code-behind. -->

        <StackPanel Grid.Row="1" Padding="40,12,40,12" Spacing="6">
            <TextBlock x:Name="StepText" Style="{StaticResource StepLabel}" Text="STEP 1 OF 3" />
            <TextBlock x:Name="StepTitle" Style="{StaticResource EditorialTitle}" Text="Welcome to SwiftX" />
            <TextBlock x:Name="StepSubtitle" Style="{StaticResource SettingBody}" MaxWidth="700"
                       HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="2" Padding="40,4,40,0">

            <!-- ==================== STEP 1 — WELCOME ==================== -->
            <Grid x:Name="WelcomeStep">
                <StackPanel VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Left"
                            Spacing="18">
                    <ContentControl x:Name="WelcomeMark" IsTabStop="False"
                                    HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource SettingBody}" FontSize="14" LineHeight="22"
                               Text="SwiftX puts the things you reach for most into an orbit that appears wherever you are — press a keyboard shortcut, shove the pointer into a screen corner, or click the tray icon, and it is there." />
                    <TextBlock Style="{StaticResource SettingBody}" FontSize="14" LineHeight="22"
                               Text="Two questions and you are set up: what goes on the orbit, and which keys bring it up. You can change any of it later from the SwiftX app." />
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SettingsAccentBrush}" />
                            <TextBlock Style="{StaticResource SettingBody}" VerticalAlignment="Center"
                                       Text="SwiftX has no taskbar button — it lives in the notification area, beside the clock." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ==================== STEP 2 — WHAT GOES ON THE ORBIT ==================== -->
            <Grid x:Name="ItemsStep" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="26" CornerRadius="13" Padding="14,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{ThemeResource ShellPillBrush}">
                        <TextBlock x:Name="SlotCountText" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SettingsSecondaryTextBrush}" />
                    </Border>
                    <Button Grid.Column="1" Content="Add your own…" CornerRadius="6"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="OnboardingAddOwn"
                            Click="AddOwn_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- Tiles are built in code (RebuildSuggestions) from OnboardingCatalog, which
                         existence-checks each candidate against this machine — so the grid has no
                         fixed content to declare here. -->
                    <Grid x:Name="SuggestionGrid" ColumnSpacing="12" RowSpacing="8"
                          Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ==================== STEP 3 — HOW TO SUMMON IT ==================== -->
            <Grid x:Name="ShortcutStep" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" HorizontalAlignment="Stretch"
                                Margin="0,0,0,16">

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="18"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Keyboard shortcut" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Click the button and press the keys you want. Hold Ctrl, Alt or Win with an ordinary key."
                                               Style="{StaticResource SettingBody}" />
                                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource SettingBody}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center">
                                    <controls:HotkeyCaptureButton x:Name="HotkeyCapture"
                                                                  VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="HotkeyEnabledToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="Keyboard shortcut"
                                                  VerticalAlignment="Center"
                                                  Toggled="HotkeyEnabled_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- The pointer half of the same question, asked in the same breath: a
                             shortcut the user could not register (another app owns it) still leaves
                             them a way in. Second row collapses with the switch rather than sitting
                             there disabled. -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <PathIcon Grid.Row="0" Grid.Column="0" Data="M 0,0 L 14,0 L 0,14 Z"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Hot corner" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Shove the pointer into a screen corner to bring the orbit up."
                                               Style="{StaticResource SettingBody}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="HotCornerEnabledToggle" Grid.Row="0" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              AutomationProperties.Name="Hot corner"
                                              VerticalAlignment="Center" HorizontalAlignment="Right"
                                              Toggled="HotCornerEnabled_Toggled" />
                                <StackPanel x:Name="HotCornerOptionsRow" Grid.Row="1" Grid.Column="0"
                                            Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12"
                                            Margin="0,10,0,0">
                                    <ComboBox x:Name="HotCornerBox" MinWidth="0" Width="130"
                                              CornerRadius="6" VerticalAlignment="Center"
                                              AutomationProperties.Name="Hot corner position"
                                              SelectionChanged="HotCornerBox_SelectionChanged">
                                        <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                        <ComboBoxItem Content="Top right" Tag="TopRight" />
                                        <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                                        <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Have SwiftX waiting in the tray when you sign in."
                                               Style="{StaticResource SettingBody}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              AutomationProperties.Name="Start with Windows"
                                              VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- Asked here rather than as an InfoBar after the fact: a packaged SwiftX
                             cannot write a desktop shortcut at install time, so somebody has to ask,
                             and the set-up guide is the honest place for it. -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8FC;" FontSize="18"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Desktop shortcut" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="SwiftX has no taskbar button, so a desktop icon gives you somewhere to click."
                                               Style="{StaticResource SettingBody}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DesktopShortcutToggle" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              AutomationProperties.Name="Desktop shortcut"
                                              VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Grid Grid.Row="3" Padding="40,14,40,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Three dots rather than a progress bar: the step count is already spelled out in the
                 header, so this only has to say "short, and you are here". -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Ellipse x:Name="Dot1" Width="8" Height="8" />
                <Ellipse x:Name="Dot2" Width="8" Height="8" />
                <Ellipse x:Name="Dot3" Width="8" Height="8" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button x:Name="BackButton" Content="Back" CornerRadius="6" Visibility="Collapsed"
                        AutomationProperties.AutomationId="OnboardingBack"
                        Click="BackStep_Click" />
                <Button x:Name="NextButton" Content="Next" CornerRadius="6"
                        Style="{ThemeResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="OnboardingNext"
                        Click="NextStep_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
